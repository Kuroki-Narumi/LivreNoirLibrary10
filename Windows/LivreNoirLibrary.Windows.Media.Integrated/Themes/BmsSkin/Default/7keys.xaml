			<Convert From="Right" To="512"/>
			<Convert From="Separate" To="0"/>
		</Variable>
		<Variable Key="layout_2p_frame" Value="$Options.Layout">
			<Convert From="Left" To="384"/>
			<Convert From="Right" To="896"/>
			<Convert From="Separate" To="896"/>
		</Variable>
		<Variable Key="layout_bga" Value="$Options.Layout">
			<Convert From="Left" To="768"/>
			<Convert From="Right" To="0"/>
			<Convert From="Separate" To="384"/>
		</Variable>
