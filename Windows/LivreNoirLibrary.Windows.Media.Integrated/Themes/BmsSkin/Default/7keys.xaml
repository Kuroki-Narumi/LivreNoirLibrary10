<PlaySkin DisplayName="7keys default" KeyCount="5, 7" Version="1.0" Author="ROKINA" BaseSize="1280, 720" Background="#777">
	<Skin.Options>
		<ListOption Key="Layout">
			<Option Value="Separate" IsDefault="true"/>
			<Option Value="Left" />
			<Option Value="Right" />
		</ListOption>
		<RangeOption Key="Bga Opacity" Minimum="0" Maximum="1" DefaultValue="1"/>
	</Skin.Options>
	<Skin.Variables>
		<!-- frame position -->
		<Variable Key="layout_1p_frame" Value="$Options.Layout">
			<Convert From="Left" To="32"/>
			<Convert From="Right" To="576"/>
			<Convert From="Separate" To="32"/>
		</Variable>
		<Variable Key="layout_2p_frame" Value="$Options.Layout">
			<Convert From="Left" To="384"/>
			<Convert From="Right" To="928"/>
			<Convert From="Separate" To="928"/>
		</Variable>
		<Variable Key="layout_bga" Value="$Options.Layout">
			<Convert From="Left" To="752"/>
			<Convert From="Right" To="16"/>
			<Convert From="Separate" To="384"/>
		</Variable>
	</Skin.Variables>
	<Skin.Textures>
		<Texture Key="skin_bm" Source="skin_bm.png"/>
		
		<Texture Key="background_1p" BasedOn="skin_bm" Rect="0, 0, 320, 32"/>
		<Texture Key="background_2p" BasedOn="skin_bm" Rect="0, 32, 320, 32"/>

		<Texture Key="note_red" BasedOn="skin_bm" Rect="0, 64, 60, 8"/>
		<Texture Key="note_red_long_head" BasedOn="skin_bm" Rect="0, 93, 60, 12"/>
		<Texture Key="note_red_long_tail" BasedOn="skin_bm" Rect="0, 80, 60, 12"/>
		<Texture Key="note_red_long_body" BasedOn="skin_bm" Rect="0, 110, 60, 1"/>
		<Texture Key="note_red_long_body_active" BasedOn="skin_bm" Rect="0, 111, 60, 17" DivY="17" LoopPeriod="0.25"/>
		<Texture Key="note_red_mine" BasedOn="skin_bm" Rect="0, 72, 60, 8"/>

		<Texture Key="note_white" BasedOn="skin_bm" Rect="60, 64, 38, 8"/>
		<Texture Key="note_white_long_head" BasedOn="skin_bm" Rect="60, 93, 38, 12"/>
		<Texture Key="note_white_long_tail" BasedOn="skin_bm" Rect="60, 80, 38, 12"/>
		<Texture Key="note_white_long_body" BasedOn="skin_bm" Rect="60, 110, 38, 1"/>
		<Texture Key="note_white_long_body_active" BasedOn="skin_bm" Rect="60, 111, 38, 17" DivY="17" LoopPeriod="0.25"/>
		<Texture Key="note_white_mine" BasedOn="skin_bm" Rect="60, 72, 38, 8"/>

		<Texture Key="note_blue" BasedOn="skin_bm" Rect="98, 64, 30, 8"/>
		<Texture Key="note_blue_long_head" BasedOn="skin_bm" Rect="98, 93, 30, 12"/>
		<Texture Key="note_blue_long_tail" BasedOn="skin_bm" Rect="98, 80, 30, 12"/>
		<Texture Key="note_blue_long_body" BasedOn="skin_bm" Rect="98, 110, 30, 1"/>
		<Texture Key="note_blue_long_body_active" BasedOn="skin_bm" Rect="98, 111, 30, 17" DivY="17" LoopPeriod="0.25"/>
		<Texture Key="note_blue_mine" BasedOn="skin_bm" Rect="98, 72, 30, 8"/>
	</Skin.Textures>
	
	<Image Texture="background_1p" DestTimer="Scene_Start">
		<Destination X="$Variables.layout_1p_frame" Y="0" Width="320" Height="512"/>
	</Image>
	<Image Texture="background_2p" DestTimer="Scene_Start">
		<Destination X="$Variables.layout_2p_frame" Y="0" Width="320" Height="512"/>
	</Image>

	<Bga DestTimer="Scene_Start">
		<Destination X="$Variables.layout_bga" Y="0" Width="512" Height="512" Opacity="$Options.Bga Opacity"/>
	</Bga>

	<!-- 1P -->
	<NoteArea DestTimer="Scene_Start">
		<Destination X="$Variables.layout_1p_frame" Y="0" Width="320" Height="512"/>
		<!-- 1P Scratch -->
		<NoteLane Lane="6" X="2" Width="60"
				  Note="note_red"
				  LongHead="note_red_long_head"
				  LongTail="note_red_long_tail"
				  LongBody="note_red_long_body"
				  ActiveLongBody="note_red_long_body_active"
				  Mine="note_red_mine">
		</NoteLane>
		<!-- 1P 1 -->
		<NoteLane Lane="1" X="64" Width="38"
				  Note="note_white"
				  LongHead="note_white_long_head"
				  LongTail="note_white_long_tail"
				  LongBody="note_white_long_body"
				  ActiveLongBody="note_white_long_body_active"
				  Mine="note_white_mine">
		</NoteLane>
		<!-- 1P 2 -->
		<NoteLane Lane="2" X="104" Width="30"
				  Note="note_blue"
				  LongHead="note_blue_long_head"
				  LongTail="note_blue_long_tail"
