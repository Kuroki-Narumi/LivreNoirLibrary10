				  LongTail="note_white_long_tail"
				  LongBody="note_white_long_body"
				  ActiveLongBody="note_white_long_body_active"
				  Mine="note_white_mine">
		</NoteLane>
	</NoteArea>
	
	<!-- 2P -->
	<NoteArea DestTimer="Scene_Start">
		<Destination X="$Variables.layout_2p_frame" Y="0" Width="320" Height="512"/>
