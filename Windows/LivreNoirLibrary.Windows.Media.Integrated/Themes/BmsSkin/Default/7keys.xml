<PlaySkin Name="7keys default" KeyCount="5, 7" Version="1.0" Author="ROKINA" BaseSize="1280, 720" Background="#111">
	<Skin.Options>
		<ListOption Key="Layout">
			<Option Value="Separate" IsDefault="true"/>
			<Option Value="Left" />
			<Option Value="Right" />
		</ListOption>
		<RangeOption Key="Bga Opacity" Minimum="0" Maximum="1" DefaultValue="1"/>
		<RangeOption Key="Beam Opacity" Minimum="0" Maximum="1" DefaultValue="0.5"/>
		<RangeOption Key="Beam Height" Minimum="0" Maximum="512" DefaultValue="480"/>
	</Skin.Options>
	<Skin.Variables>
		<!-- frame position -->
		<Variable Key="layout_1p_frame" Source="$Options.Layout" DefaultValue="0">
			<Convert From="Right" To="480"/>
		</Variable>
		<Variable Key="layout_2p_frame" Source="$Options.Layout" DefaultValue="896">
			<Convert From="Left" To="384"/>
		</Variable>
		<Variable Key="layout_bga" Source="$Options.Layout" DefaultValue="384">
			<Convert From="Left" To="768"/>
			<Convert From="Right" To="0"/>
		</Variable>

		<Variable Key="title_position" Source="$Options.StageFile Defined" DefaultValue="4">
			<Convert From="True" To="244"/>
		</Variable>
		<Variable Key="title_width" Source="$Options.StageFile Defined" DefaultValue="1272">
			<Convert From="True" To="1032"/>
		</Variable>

		<Variable Key="level_number_y" Source="$Variables.Difficulty" DefaultValue="0">
			<Convert From="1" To="96"/>
			<Convert From="2" To="128"/>
			<Convert From="3" To="64"/>
			<Convert From="4" To="32"/>
			<Convert From="5" To="160"/>
		</Variable>

		<Variable Key="rank_number_y" Source="$Variables.Rank" DefaultValue="352">
			<Convert From="3" To="224"/>
			<Convert From="2" To="256"/>
			<Convert From="1" To="288"/>
			<Convert From="0" To="320"/>
		</Variable>
	</Skin.Variables>
