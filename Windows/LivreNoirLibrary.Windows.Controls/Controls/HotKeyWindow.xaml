<Window x:Class="LivreNoirLibrary.Windows.Controls.HotKeyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LivreNoirLibrary.Windows.Controls"
        xmlns:md="clr-namespace:LivreNoirLibrary.Windows.Media;assembly=LivreNoirLibrary.Windows.Media"
        mc:Ignorable="d" ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True" ShowInTaskbar="False"
        Topmost="True" Background="{local:BrushProvider #8000}"
        Title="HotKeyWindow" Height="450" Width="800">
    <Grid ColumnDefinitions="*, Auto, *" RowDefinitions="*, Auto, *">
        <Border Grid.Row="1" Grid.Column="1" Background="White">
            <TextBlock x:Name="TextBlock" Margin="8" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center">
                Press Key...<LineBreak/>
                (ESC to cancel)
            </TextBlock>
        </Border>
    </Grid>
</Window>
