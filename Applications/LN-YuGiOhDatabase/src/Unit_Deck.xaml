<UserControl x:Class="LivreNoir.YuGiOhDatabase.Unit_Deck"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:LivreNoir.YuGiOhDatabase"
             xmlns:ct="clr-namespace:LivreNoirLibrary.Windows.Controls;assembly=LivreNoirLibrary.Windows.Controls"
             xmlns:media="clr-namespace:LivreNoirLibrary.Windows.Media;assembly=LivreNoirLibrary.Windows.Media"
             xmlns:yw="clr-namespace:LivreNoirLibrary.Windows.YuGiOh;assembly=LivreNoirLibrary.Windows.YuGiOh"
             xmlns:yc="clr-namespace:LivreNoirLibrary.Windows.YuGiOh.Controls;assembly=LivreNoirLibrary.Windows.YuGiOh"
             xmlns:ygo="clr-namespace:LivreNoirLibrary.YuGiOh.Data;assembly=LivreNoirLibrary.YuGiOh.Core"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=local:MainViewModel}"
             Style="{StaticResource ControlBase}" d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <TabControl x:Name="MainUI">
            <TabItem Header="{Binding Tab_DeckEdit.Value, Source={x:Static yw:Vocab.Current}}">
                <yc:DeckEditor x:Name="DeckEditor" CardProvider="{Binding CardPool.Cards}" Deck="{Binding Deck}"/>
            </TabItem>
            <TabItem Header="{Binding Tab_CardTable.Value, Source={x:Static yw:Vocab.Current}}">
                <yc:DeckRecipeControl Deck="{Binding Deck}" LineBreaks="{Binding CardNameLBPositions}"/>
            </TabItem>
            <TabItem Header="{Binding Tab_SwSearch.Value, Source={x:Static yw:Vocab.Current}}">
                <yc:FindRelayControl ItemsSource="{Binding Deck.MainDeck}" CardProvider="{Binding CardPool.Cards}"/>
            </TabItem>
            <TabItem Header="{Binding Tab_SwInDeck.Value, Source={x:Static yw:Vocab.Current}}">
                <yc:SmallWorldGraphControl ItemsSource="{Binding Deck.MainDeck}"/>
            </TabItem>
            <TabItem Header="{Binding Tab_TestConds.Value, Source={x:Static yw:Vocab.Current}}">
                <yc:HandInspectEditor Conditions="{Binding HandInspectConditions}" CardProvider="{Binding CardPool.Cards}" CardSource="{Binding Deck.MainDeck}"/>
            </TabItem>
            <TabItem Header="{Binding Tab_TestExec.Value, Source={x:Static yw:Vocab.Current}}">
                <yc:HandTestView x:Name="HandTestView" Conditions="{Binding HandInspectConditions}" CardSource="{Binding Deck.MainDeck}" TestParams="{Binding HandTestParams}"/>
            </TabItem>
        </TabControl>
        <ct:TaskProgressBar x:Name="TaskProgressBar"/>
    </Grid>
</UserControl>
