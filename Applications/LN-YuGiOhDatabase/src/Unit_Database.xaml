<UserControl x:Class="LivreNoir.YuGiOhDatabase.Unit_Database"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:LivreNoir.YuGiOhDatabase"
             xmlns:ct="clr-namespace:LivreNoirLibrary.Windows.Controls;assembly=LivreNoirLibrary.Windows.Controls"
             xmlns:media="clr-namespace:LivreNoirLibrary.Windows.Media;assembly=LivreNoirLibrary.Windows.Media"
             xmlns:yw="clr-namespace:LivreNoirLibrary.Windows.YuGiOh;assembly=LivreNoirLibrary.Windows.YuGiOh"
             xmlns:yc="clr-namespace:LivreNoirLibrary.Windows.YuGiOh.Controls;assembly=LivreNoirLibrary.Windows.YuGiOh"
             xmlns:ygo="clr-namespace:LivreNoirLibrary.YuGiOh.Data;assembly=LivreNoirLibrary.YuGiOh.Core"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=local:MainViewModel}"
             Style="{StaticResource ControlBase}" d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <TabControl SelectionChanged="OnSelectionChanged_Tab">
            <TabItem x:Name="Tab_CardList">
                <TabItem.Header>
                    <Grid ColumnDefinitions="*, 4, Auto">
                        <TextBlock Text="{Binding Tab_CardList.Value, Source={x:Static yw:Vocab.Current}}"/>
                        <ct:Button Grid.Column="2" Style="{StaticResource IconButtonBase}" Padding="2,0" Icon="{x:Static media:Icons.NewWindow}" ToolTip="{Binding Detach.Value, Source={x:Static yw:Vocab.Current}}" Command="yw:YgoCommands.DetachCardList"/>
                    </Grid>
                </TabItem.Header>
                <Grid ColumnDefinitions="*, 4, 2*">
                    <Grid RowDefinitions="Auto, 4, *">
                        <yc:CardSearchBar x:Name="SearchBar" ListBox="{Binding ElementName=ListView_CardList}" DefaultSearchConditions="{Binding Database.DefaultCardSearchConditions}" DefaultSortOptions="{Binding Database.DefaultCardSortOptions}"/>
                        <ListView x:Name="ListView_CardList" Grid.Row="2" Style="{StaticResource CardListView}" ItemsSource="{Binding CardPool.Cards}" SelectedItem="{Binding Database.SelectedCard, Mode=TwoWay}"/>
                    </Grid>
                    <yc:CardInfoView Grid.Column="2" Source="{Binding Database.SelectedCard}"/>
                </Grid>
            </TabItem>
            <TabItem x:Name="Tab_PackList" Header="{Binding Tab_PackList.Value, Source={x:Static yw:Vocab.Current}}">
                <Grid ColumnDefinitions="*, 4, 2*">
                    <Grid RowDefinitions="Auto, 4, *">
                        <yc:PackSearchBar ListBox="{Binding ElementName=ListView_PackList}"/>
                        <ListView x:Name="ListView_PackList" Grid.Row="2" Style="{StaticResource Alt2ListBoxStyle}" SelectionMode="Single" ItemsSource="{Binding CardPool.Packs}" SelectedItem="{Binding Database.SelectedPack, Mode=TwoWay}">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <TextBlock Text="{Binding Name}"/>
                                        <Popup x:Name="Popup" IsOpen="False">
                                            <Border Style="{StaticResource HelpPopupContent}">
                                                <TextBlock Text="{Binding Name}"/>
                                            </Border>
                                        </Popup>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Popup" Property="IsOpen" Value="True"/>
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                    <yc:PackInfoView Grid.Column="2" Source="{Binding Database.SelectedPack}"/>
                </Grid>
            </TabItem>
            <TabItem Header="{Binding Tab_Regulation.Value, Source={x:Static yw:Vocab.Current}}">
                <yc:RegulationEditor x:Name="RegulationEditor" Regulation="{Binding Regulation}"/>
            </TabItem>
            <TabItem Header="{Binding Tab_OriginalCards.Value, Source={x:Static yw:Vocab.Current}}">
                <yc:CardEditor ItemsSource="{Binding OriginalCards}"/>
            </TabItem>
        </TabControl>
        <ct:Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="1" Padding="2,0" Icon="{x:Static media:Icons.Update}" Content="{Binding CardUpdate.Value, Source={x:Static yw:Vocab.Current}}" ToolTip="{Binding Desc_CardUpdate.Value, Source={x:Static yw:Vocab.Current}}" Visibility="{Binding Database.IsUpdateVisible, Converter={StaticResource BVConv}}" Command="yw:YgoCommands.UpdateDatabase"/>
    </Grid>
</UserControl>
