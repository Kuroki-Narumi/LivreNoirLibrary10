<UserControl x:Class="LivreNoir.YuGiOhDatabase.Unit_Statistics"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:LivreNoir.YuGiOhDatabase"
             xmlns:ct="clr-namespace:LivreNoirLibrary.Windows.Controls;assembly=LivreNoirLibrary.Windows.Controls"
             xmlns:media="clr-namespace:LivreNoirLibrary.Windows.Media;assembly=LivreNoirLibrary.Windows.Media"
             xmlns:yw="clr-namespace:LivreNoirLibrary.Windows.YuGiOh;assembly=LivreNoirLibrary.Windows.YuGiOh"
             xmlns:yc="clr-namespace:LivreNoirLibrary.Windows.YuGiOh.Controls;assembly=LivreNoirLibrary.Windows.YuGiOh"
             xmlns:ygo="clr-namespace:LivreNoirLibrary.YuGiOh.Data;assembly=LivreNoirLibrary.YuGiOh.Core"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=local:MainViewModel}"
             Style="{StaticResource ControlBase}" d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <TabControl>
            <TabItem Header="{Binding Tab_TableView.Value, Source={x:Static yw:Vocab.Current}}">
                <yc:CardTableView CardProvider="{Binding CardPool.Cards}"/>
            </TabItem>
            <TabItem Header="{Binding Tab_Token.Value, Source={x:Static yw:Vocab.Current}}">
                <yc:TokenView ItemsSource="{Binding Tokens}"/>
            </TabItem>
            <TabItem Header="{Binding Tab_TrapMonster.Value, Source={x:Static yw:Vocab.Current}}">
                <yc:TrapMonsterView ItemsSource="{Binding TrapMonsters}"/>
            </TabItem>
            <TabItem Header="{Binding Tab_StatusMatch.Value, Source={x:Static yw:Vocab.Current}}">
                <yc:StatusMatchView ItemsSource="{Binding CardPool.Cards}"/>
            </TabItem>
            <TabItem Header="{Binding Tab_Hedgehog.Value, Source={x:Static yw:Vocab.Current}}">
                <yc:HedgehogView ItemsSource="{Binding CardPool.Cards}"/>
            </TabItem>
            <TabItem Header="{Binding Tab_Numbers.Value, Source={x:Static yw:Vocab.Current}}">
                <yc:NumbersView ItemsSource="{Binding CardPool.Cards}"/>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
