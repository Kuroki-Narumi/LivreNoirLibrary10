<ct:FollowOwnerWindow x:Class="LivreNoir.Clock.Window_Config"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LivreNoir.Clock"
        xmlns:ct="clr-namespace:LivreNoirLibrary.Windows.Controls;assembly=LivreNoirLibrary.Windows.Controls"
        xmlns:conv="clr-namespace:LivreNoirLibrary.Windows.Converters;assembly=LivreNoirLibrary.Windows.Controls"
        xmlns:media="clr-namespace:LivreNoirLibrary.Windows.Media;assembly=LivreNoirLibrary.Windows.Media"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=local:MainViewModel}"
        FontSize="14" SizeToContent="WidthAndHeight"
        UseLayoutRounding="True"
        Title="Config" ShowInTaskbar="False" ResizeMode="NoResize" WindowStyle="ToolWindow">
    <StackPanel Grid.IsSharedSizeScope="True" Margin="4">
        <StackPanel.Resources>
            <Style TargetType="TextBlock" x:Key="Header">
                <Setter Property="Margin" Value="4,0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="HorizontalAlignment" Value="Right"/>
            </Style>
            <Style TargetType="CheckBox">
                <Setter Property="Grid.Column" Value="1"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>
            <Style TargetType="ct:IntTextBox">
                <Setter Property="Width" Value="80"/>
                <Setter Property="Margin" Value="0,2"/>
                <Setter Property="HorizontalContentAlignment" Value="Right"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="InputMethod.IsInputMethodEnabled" Value="False"/>
            </Style>
            <Style TargetType="ct:DoubleTextBox">
                <Setter Property="Width" Value="48"/>
                <Setter Property="HorizontalContentAlignment" Value="Right"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="InputMethod.IsInputMethodEnabled" Value="False"/>
            </Style>
            <conv:DoubleLinearConverter x:Key="PercentConverter" Slope="100" Rounding="Round"/>
        </StackPanel.Resources>
        <Grid Margin="0,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="1.5*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Style="{StaticResource Header}" Text="位置"/>
            <Grid Grid.Column="1" ColumnDefinitions="Auto, Auto, Auto, Auto" RowDefinitions="Auto, 2, Auto">
                <TextBlock Grid.Column="0" Grid.Row="0" Style="{StaticResource Header}" Text="X"/>
                <TextBlock Grid.Column="0" Grid.Row="2" Style="{StaticResource Header}" Text="Y"/>
                <TextBlock Grid.Column="2" Grid.Row="0" Style="{StaticResource Header}" Text="幅"/>
                <TextBlock Grid.Column="2" Grid.Row="2" Style="{StaticResource Header}" Text="高さ"/>
                <ct:DoubleTextBox Grid.Column="1" Grid.Row="0" Minimum="{x:Static media:Screen.Left}" Maximum="{x:Static media:Screen.Right}" Value="{Binding Left}"/>
                <ct:DoubleTextBox Grid.Column="1" Grid.Row="2" Minimum="{x:Static media:Screen.Top}" Maximum="{x:Static media:Screen.Bottom}" Value="{Binding Top}"/>
                <ct:DoubleTextBox Grid.Column="3" Grid.Row="0" Minimum="{x:Static local:MainViewModel.MinWidth}" Maximum="{x:Static local:MainViewModel.MaxWidth}" Value="{Binding Width}"/>
                <ct:DoubleTextBox Grid.Column="3" Grid.Row="2" Minimum="{x:Static local:MainViewModel.MinHeight}" Maximum="{x:Static local:MainViewModel.MaxHeight}" Value="{Binding Height}"/>
            </Grid>
            <TextBlock Grid.Column="2" Style="{StaticResource Header}" Text="表示"/>
            <Grid Grid.Column="3" RowDefinitions="*, *">
                <CheckBox Grid.Row="0" IsChecked="{Binding Topmost}" Content="最前面"/>
                <CheckBox Grid.Row="1" IsChecked="{Binding ShowInTaskbar}" Content="タスクバー"/>
            </Grid>
        </Grid>
        <Border Style="{StaticResource HorizontalSeparator}"/>
        <Grid Margin="0,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Style="{StaticResource Header}" Text="背景"/>
            <ct:ColorPicker Grid.Column="1" IndicatorWidth="60" IsAlphaEnabled="True" SelectedColor="{Binding Background}"/>
            <TextBlock Grid.Column="3" Style="{StaticResource Header}" Text="文字"/>
            <ct:ColorPicker Grid.Column="4" IndicatorWidth="60" SelectedColor="{Binding Foreground}"/>
        </Grid>
        <Grid Margin="0,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="Header"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource Header}" Text="フォント"/>
            <ct:FontSelector Grid.Column="1" Width="280" Height="32" SelectedFontFamily="{Binding FontFamily, Mode=TwoWay}" DisplayFontSource="True" PreviewMouseWheel="OnMouseWheel_ComboBox"/>
        </Grid>
        <Grid Margin="0,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="Header"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource Header}" Text="形式"/>
            <ct:EditableTextBlock Grid.Column="1" Width="256" Text="{Binding StringFormat}" IsClearButtonVisible="False" VerticalContentAlignment="Center"/>
            <ct:ToggleButton x:Name="HelpButton_Format" Grid.Column="2" Style="{StaticResource HelpToggleButton}"/>
            <Popup PlacementTarget="{Binding ElementName=HelpButton_Format}" Placement="Bottom" IsOpen="{Binding IsChecked, ElementName=HelpButton_Format}">
                <Border Style="{StaticResource HelpPopupContent}">
                    <Border.Resources>
                        <Style x:Key="Head" TargetType="TextBlock" BasedOn="{StaticResource Header}">
                            <Setter Property="Margin" Value="0,4"/>
                        </Style>
                        <Style x:Key="Delimiter" TargetType="TextBlock">
                            <Setter Property="Grid.Column" Value="1"/>
                            <Setter Property="Margin" Value="4,4"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Text" Value="-"/>
                        </Style>
                        <Style x:Key="Content" TargetType="TextBlock">
                            <Setter Property="Grid.Column" Value="2"/>
                            <Setter Property="Margin" Value="0,4"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="HorizontalAlignment" Value="Left"/>
                        </Style>
                    </Border.Resources>
                    <Grid ColumnDefinitions="Auto, Auto, Auto" RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto">
                        <TextBlock Grid.Row="0" Style="{StaticResource Head}" Text="yyyy"/>
                        <TextBlock Grid.Row="1" Style="{StaticResource Head}" Text="MM"/>
                        <TextBlock Grid.Row="2" Style="{StaticResource Head}" Text="MMM"/>
                        <TextBlock Grid.Row="3" Style="{StaticResource Head}" Text="dd"/>
                        <TextBlock Grid.Row="4" Style="{StaticResource Head}" Text="ddd"/>
                        <Border Grid.Row="5" Style="{StaticResource HorizontalSeparator}"/>
                        <TextBlock Grid.Row="6" Style="{StaticResource Head}" Text="HH"/>
                        <TextBlock Grid.Row="7" Style="{StaticResource Head}" Text="hh"/>
                        <TextBlock Grid.Row="8" Style="{StaticResource Head}" Text="tt"/>
                        <TextBlock Grid.Row="9" Style="{StaticResource Head}" Text="mm"/>
                        <TextBlock Grid.Row="10" Style="{StaticResource Head}" Text="ss"/>
                        <TextBlock Grid.Row="11" Style="{StaticResource Head}" Text="fff"/>
                        
                        <TextBlock Grid.Row="0" Style="{StaticResource Delimiter}"/>
                        <TextBlock Grid.Row="1" Style="{StaticResource Delimiter}"/>
                        <TextBlock Grid.Row="2" Style="{StaticResource Delimiter}"/>
                        <TextBlock Grid.Row="3" Style="{StaticResource Delimiter}"/>
                        <TextBlock Grid.Row="4" Style="{StaticResource Delimiter}"/>
                        
                        <TextBlock Grid.Row="6" Style="{StaticResource Delimiter}"/>
                        <TextBlock Grid.Row="7" Style="{StaticResource Delimiter}"/>
                        <TextBlock Grid.Row="8" Style="{StaticResource Delimiter}"/>
                        <TextBlock Grid.Row="9" Style="{StaticResource Delimiter}"/>
                        <TextBlock Grid.Row="10" Style="{StaticResource Delimiter}"/>
                        <TextBlock Grid.Row="11" Style="{StaticResource Delimiter}"/>
                        
                        <TextBlock Grid.Row="0" Style="{StaticResource Content}" Text="year(0001-9999)"/>
                        <TextBlock Grid.Row="1" Style="{StaticResource Content}" Text="month(01-12)"/>
                        <TextBlock Grid.Row="2" Style="{StaticResource Content}" Text="month name"/>
                        <TextBlock Grid.Row="3" Style="{StaticResource Content}" Text="day(01-31)"/>
                        <TextBlock Grid.Row="4" Style="{StaticResource Content}" Text="weekday name"/>

                        <TextBlock Grid.Row="6" Style="{StaticResource Content}" Text="hour(00-24)"/>
                        <TextBlock Grid.Row="7" Style="{StaticResource Content}" Text="hour(00-12)"/>
                        <TextBlock Grid.Row="8" Style="{StaticResource Content}" Text="am/pm"/>
                        <TextBlock Grid.Row="9" Style="{StaticResource Content}" Text="minute(00-59)"/>
                        <TextBlock Grid.Row="10" Style="{StaticResource Content}" Text="second(00-60)"/>
                        <TextBlock Grid.Row="11" Style="{StaticResource Content}" Text="millisecond(000-999)"/>
                    </Grid>
                </Border>
            </Popup>
        </Grid>
        <Border Style="{StaticResource HorizontalSeparator}"/>
        <Grid Margin="0,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="Header"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource Header}" Text="更新間隔"/>
            <ct:IntTextBox Grid.Column="1" Minimum="10" Maximum="60000" WheelStep="50" Value="{Binding UpdateInterval}"/>
            <TextBlock Grid.Column="2" Margin="2,0" Text="ms" VerticalAlignment="Bottom"/>
            <ct:Button Grid.Column="4" Icon="{x:Static media:Icons.Update}" Content="同期" Click="OnClick_Update"/>
        </Grid>
        <Border Style="{StaticResource HorizontalSeparator}"/>
        <ct:Button Margin="0,2" HorizontalAlignment="Right" Icon="{x:Static media:Icons.Delete_Mono}" Content="初期化" Click="OnClick_Reset"/>
    </StackPanel>
</ct:FollowOwnerWindow>
