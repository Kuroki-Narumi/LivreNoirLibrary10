<Window x:Class="LivreNoir.ImageEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LivreNoir.ImageEditor"
        xmlns:ctrl="clr-namespace:LivreNoirLibrary.Windows.Controls;assembly=LivreNoirLibrary.Windows.Controls"
        xmlns:md="clr-namespace:LivreNoirLibrary.Windows.Media;assembly=LivreNoirLibrary.Windows.Media"
        xmlns:conv="clr-namespace:LivreNoirLibrary.Windows.Converters;assembly=LivreNoirLibrary.Windows.Controls"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=local:MainWindow}"
        Title="LN Image Editor" Height="800" Width="1280" FontSize="14" AllowDrop="True" UseLayoutRounding="True">
    <TabControl MouseWheel="OnMouseWheel_Tab">
        <TabItem Header="Main">
            <Grid>
                <Grid x:Name="MainUI">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="4*"/>
                    </Grid.ColumnDefinitions>
                    <ListView x:Name="ImageList" ItemsSource="{Binding ImageItems}" Style="{StaticResource Alt2ListBoxStyle}">
                        <ListView.CommandBindings>
                            <CommandBinding Command="ApplicationCommands.Delete" CanExecute="Image_CanExecute_Delete" Executed="Image_Executed_Delete"/>
                        </ListView.CommandBindings>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="4"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Filename}" FontWeight="Bold"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Size}" HorizontalAlignment="Right" FontSize="12" FontFamily="Consolas"/>
                                    </Grid>
                                    <Image Grid.Row="1" Source="{Binding Image}" MaxHeight="80" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch"/>
                    <ctrl:ImageRectSelector x:Name="ImageRectSelector" Grid.Column="2" Source="{Binding SelectedItem.Image, ElementName=ImageList, Mode=OneWay}">
                        <ctrl:ImageRectSelector.RightPanel>
                            <ctrl:Button Icon="{x:Static md:Icons.Save}" Content="切り抜き" Click="OnClick_Clip"/>
                            <ctrl:Button Icon="{x:Static md:Icons.Save}" Content="自動切り抜き" Click="OnClick_AutoClip"/>
                        </ctrl:ImageRectSelector.RightPanel>
                    </ctrl:ImageRectSelector>
                </Grid>
                <ctrl:TaskProgressBar x:Name="TaskProgressBar"/>
            </Grid>
        </TabItem>
        <TabItem Header="Console">
            <ctrl:ConsoleViewer Background="Black"/>
        </TabItem>
    </TabControl>
</Window>
