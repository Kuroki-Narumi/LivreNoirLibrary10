<Window x:Class="LNClock.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LNClock"
        xmlns:ct="clr-namespace:LivreNoirLibrary.Windows.Controls;assembly=LivreNoirLibrary.Windows.Controls"
        mc:Ignorable="d"
        Title="LN Clock"
        AllowsTransparency="True" WindowStyle="None" ResizeMode="NoResize"
        d:DataContext="{d:DesignInstance local:MainViewModel}" Background="{ct:BrushProvider Color=#01000000}"
        Topmost="{Binding Topmost}" ShowInTaskbar="{Binding ShowInTaskbar}" MinWidth="{x:Static local:MainViewModel.MinWidth}" MinHeight="{x:Static local:MainViewModel.MinHeight}"
        Width="{x:Static local:MainWindow.DefaultWidth}" Height="{x:Static local:MainWindow.DefaultHeight}"
        >
    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="設定" Click="OnClick_Config"/>
            <MenuItem Header="終了" Click="OnClick_Close"/>
        </ContextMenu>
    </Window.ContextMenu>
    <Grid>
        <Rectangle>
            <Rectangle.Fill>
                <SolidColorBrush Color="{Binding Background}"/>
            </Rectangle.Fill>
        </Rectangle>
        <Viewbox>
            <TextBlock Text="{Binding CurrentText}" FontFamily="{Binding FontFamily}" FontWeight="Bold">
                <TextBlock.Foreground>
                    <SolidColorBrush Color="{Binding Foreground}"/>
                </TextBlock.Foreground>
            </TextBlock>
        </Viewbox>
        <ct:ResizeGrip/>
    </Grid>
</Window>
