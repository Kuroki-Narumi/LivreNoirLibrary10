<UserControl x:Class="LivreNoirLibrary.Windows.YuGiOh.Controls.DuelLogStatisticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:LivreNoirLibrary.Windows.YuGiOh.Controls"
             xmlns:ct="clr-namespace:LivreNoirLibrary.Windows.Controls;assembly=LivreNoirLibrary.Windows.Controls"
             xmlns:media="clr-namespace:LivreNoirLibrary.Windows.Media;assembly=LivreNoirLibrary.Windows.Media"
             xmlns:yw="clr-namespace:LivreNoirLibrary.Windows.YuGiOh;assembly=LivreNoirLibrary.Windows.YuGiOh"
             xmlns:ygo="clr-namespace:LivreNoirLibrary.YuGiOh.Data;assembly=LivreNoirLibrary.YuGiOh.Core"
             xmlns:ys="clr-namespace:LivreNoirLibrary.YuGiOh.Search;assembly=LivreNoirLibrary.YuGiOh.Core"
             xmlns:ymd="clr-namespace:LivreNoirLibrary.YuGiOh.MasterDuel;assembly=LivreNoirLibrary.YuGiOh.Core"
             mc:Ignorable="d" Background="White"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/LivreNoirLibrary.Windows.YuGiOh;component/Themes/Generic.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="GridViewColumnHeader">
                <EventSetter Event="Click" Handler="OnClick_ColumnHeader" />
            </Style>
            <Style TargetType="ct:ToggleButton">
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Margin" Value="0"/>
                <Setter Property="Padding" Value="4"/>
                <Setter Property="CornerRadius" Value="0"/>
                <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnMouseLeftButtonDown_ToggleButton"/>
                <EventSetter Event="MouseEnter" Handler="OnMouseEnter_ToggleButton"/>
            </Style>
            <Style TargetType="ListView" BasedOn="{StaticResource Alt2ListBoxStyle}">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="SelectionMode" Value="Single"/>
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Visible"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid x:Name="MainGrid" ColumnDefinitions="2*, 4, 3*" d:DataContext="{d:DesignInstance Type=local:DuelLogStatisticsView}">
            <Grid RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto, *" Grid.IsSharedSizeScope="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Header"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Label Style="{StaticResource Label_Header}" Content="{Binding DLog.DateTime.Value, Source={x:Static yw:Vocab.Current}}"/>
                    <ct:DateTimePicker Grid.Column="1" SelectedDate="{Binding SearchConditions.DateStart}"/>
                    <TextBlock Grid.Column="2" Text="～" Margin="4,0" VerticalAlignment="Center"/>
                    <ct:DateTimePicker Grid.Column="3" SelectedDate="{Binding SearchConditions.DateEnd}"/>
                    <ct:Button Grid.Column="5" Style="{StaticResource IconButton_AllClear}" Icon="{x:Static media:Icons.Cross_Red}"/>
                </Grid>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Header"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Label Style="{StaticResource Label_Header}" Content="{Binding DLog.User.Value, Source={x:Static yw:Vocab.Current}}"/>
                    <local:DeckTagSelector Grid.Column="1" x:Name="UserSelector" ItemsSource="{Binding DeckTagSource}" SelectedItemChanged="User_TagChanged"/>
                    <local:MatchTypeSelector Grid.Column="2" MatchType="{Binding SearchConditions.UserTagMatchType}"/>
                </Grid>
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Header"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Label Style="{StaticResource Label_Header}" Content="{Binding DLog.Opponent.Value, Source={x:Static yw:Vocab.Current}}"/>
                    <local:DeckTagSelector Grid.Column="1" x:Name="OpponentSelector" ItemsSource="{Binding DeckTagSource}" SelectedItemChanged="Opponent_TagChanged"/>
                    <local:MatchTypeSelector Grid.Column="2" MatchType="{Binding SearchConditions.OpponentTagMatchType}"/>
                </Grid>
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Header"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Header2"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label Style="{StaticResource Label_Header}" Content="{Binding DLog.Rank.Value, Source={x:Static yw:Vocab.Current}}"/>
                    <ct:DropDownMenuButton Grid.Column="1" DropDownClosed="DDMB_Rank_Closed">
                        <Grid>
                            <Border x:Name="Rank_Width"/>
                            <TextBlock>
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource SelectedTextConv}">
                                        <Binding Path="Flags.RankText"/>
                                        <Binding Path="Flags.RankCount"/>
                                        <Binding Path="" RelativeSource="{RelativeSource Mode=Self}"/>
                                        <Binding Path="ActualWidth" ElementName="Rank_Width"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </Grid>
                        <ct:DropDownMenuButton.DropDownContent>
                            <ItemsControl ItemsSource="{Binding Flags.Rank}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Grid ColumnDefinitions="Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto" RowDefinitions="Auto, 4, Auto, Auto, Auto, Auto, Auto"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Grid.Row" Value="{Binding Row}"/>
                                        <Setter Property="Grid.Column" Value="{Binding Column}"/>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ct:ToggleButton Background="{Binding Background}" Content="{Binding Name.Value}" IsChecked="{Binding IsChecked}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ct:DropDownMenuButton.DropDownContent>
                    </ct:DropDownMenuButton>
                    <Label Style="{StaticResource Label_Header}" Grid.Column="2" Content="{Binding DLog.Order.Value, Source={x:Static yw:Vocab.Current}}"/>
                    <ct:DropDownMenuButton Grid.Column="3" DropDownClosed="DDMB_Order_Closed">
                        <Grid>
                            <Border x:Name="Order_Width"/>
                            <TextBlock>
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource SelectedTextConv}">
                                        <Binding Path="Flags.OrderText"/>
                                        <Binding Path="Flags.OrderCount"/>
                                        <Binding Path="" RelativeSource="{RelativeSource Mode=Self}"/>
                                        <Binding Path="ActualWidth" ElementName="Order_Width"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </Grid>
                        <ct:DropDownMenuButton.DropDownContent>
                            <ItemsControl ItemsSource="{Binding Flags.Order}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Grid ColumnDefinitions="Auto, Auto, Auto" RowDefinitions="Auto, Auto, Auto"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Grid.Row" Value="{Binding Row}"/>
                                        <Setter Property="Grid.Column" Value="{Binding Column}"/>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ct:ToggleButton Background="{Binding Background}" Content="{Binding Name.Value}" IsChecked="{Binding IsChecked}" IsOptionMarkVisible="{Binding IsOptionMarkVisible}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ct:DropDownMenuButton.DropDownContent>
                    </ct:DropDownMenuButton>
                </Grid>
                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Header"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Header2"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label Style="{StaticResource Label_Header}" Content="{Binding DLog.Turn.Value, Source={x:Static yw:Vocab.Current}}"/>
                    <ct:RangeSlider Grid.Column="1" Minimum="0" Maximum="99" Value1="{Binding SearchConditions.Turn.LowerBound}" Value2="{Binding SearchConditions.Turn.UpperBound}" Margin="0,2"/>
                    <Label Style="{StaticResource Label_Header}" Grid.Column="2" Content="{Binding DLog.Result.Value, Source={x:Static yw:Vocab.Current}}"/>
                    <ct:DropDownMenuButton Grid.Column="3" DropDownClosed="DDMB_Result_Closed">
                        <Grid>
                            <Border x:Name="Result_Width"/>
                            <TextBlock>
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource SelectedTextConv}">
                                        <Binding Path="Flags.ResultText"/>
                                        <Binding Path="Flags.ResultCount"/>
                                        <Binding Path="" RelativeSource="{RelativeSource Mode=Self}"/>
                                        <Binding Path="ActualWidth" ElementName="Result_Width"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </Grid>
                        <ct:DropDownMenuButton.DropDownContent>
                            <ItemsControl ItemsSource="{Binding Flags.Result}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Grid ColumnDefinitions="Auto, Auto" RowDefinitions="Auto, Auto, Auto"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Grid.Row" Value="{Binding Row}"/>
                                        <Setter Property="Grid.Column" Value="{Binding Column}"/>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ct:ToggleButton Background="{Binding Background}" Content="{Binding Name.Value}" IsChecked="{Binding IsChecked}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ct:DropDownMenuButton.DropDownContent>
                    </ct:DropDownMenuButton>
                </Grid>
                <Grid Grid.Row="5" ColumnDefinitions="*, 3*, *">
                    <ct:Button Grid.Column="1" Margin="4" Icon="{x:Static media:Icons.Check_Green}" Content="{Binding DLog.RefreshStatistics.Value, Source={x:Static yw:Vocab.Current}}" Click="OnClick_Refresh"/>
                    <TextBlock Grid.Column="2" Style="{StaticResource TextBlock_SearchBarCount}" Text="{Binding Items.Count, ElementName=ListView_Logs}"/>
                </Grid>
                <ListView x:Name="ListView_Logs" Grid.Row="6" ItemsSource="{Binding Statistics.Logs}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn HeaderTemplate="{StaticResource GridViewHeader_Rank}" CellTemplate="{StaticResource ItemTemplate_Rank}"/>
                            <GridViewColumn HeaderTemplate="{StaticResource GridViewHeader_Order}" CellTemplate="{StaticResource ItemTemplate_Order}"/>
                            <GridViewColumn HeaderTemplate="{StaticResource GridViewHeader_Turn}" CellTemplate="{StaticResource ItemTemplate_Turn}"/>
                            <GridViewColumn HeaderTemplate="{StaticResource GridViewHeader_Result}" CellTemplate="{StaticResource ItemTemplate_Result}"/>
                            <GridViewColumn HeaderTemplate="{StaticResource GridViewHeader_Opponent}" CellTemplate="{StaticResource ItemTemplate_Opponent}"/>
                            <GridViewColumn HeaderTemplate="{StaticResource GridViewHeader_DateTime}" CellTemplate="{StaticResource ItemTemplate_DateTime}"/>
                            <GridViewColumn HeaderTemplate="{StaticResource GridViewHeader_User}" CellTemplate="{StaticResource ItemTemplate_User}"/>
                            <GridViewColumn HeaderTemplate="{StaticResource GridViewHeader_Note}" CellTemplate="{StaticResource ItemTemplate_Note}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
            <TabControl Grid.Column="2" x:Name="StatisticsView">
                <TabItem Header="{Binding DLog.Tab_Tag.Value, Source={x:Static yw:Vocab.Current}}">
                    <ListView x:Name="ListView_DeckTagSet" ItemsSource="{Binding Statistics.DeckTagSet}">
                        <ListView.View>
                            <GridView AllowsColumnReorder="False">
                                <GridViewColumn HeaderTemplate="{StaticResource GridViewHeader_DS_Tag}" CellTemplate="{StaticResource ItemTemplate_DS_Tag}"/>
                                <GridViewColumn HeaderTemplate="{StaticResource GridViewHeader_DS_Count}" CellTemplate="{StaticResource ItemTemplate_DS_Count}"/>
                                <GridViewColumn HeaderTemplate="{StaticResource GridViewHeader_DS_CountRatio}" CellTemplate="{StaticResource ItemTemplate_DS_CountRatio}"/>
                                <GridViewColumn HeaderTemplate="{StaticResource GridViewHeader_DS_Win}" CellTemplate="{StaticResource ItemTemplate_DS_Win}"/>
                                <GridViewColumn HeaderTemplate="{StaticResource GridViewHeader_DS_WinRatio}" CellTemplate="{StaticResource ItemTemplate_DS_WinRatio}"/>
                                <GridViewColumn HeaderTemplate="{StaticResource GridViewHeader_DS_Lose}" CellTemplate="{StaticResource ItemTemplate_DS_Lose}"/>
                                <GridViewColumn HeaderTemplate="{StaticResource GridViewHeader_DS_LoseRatio}" CellTemplate="{StaticResource ItemTemplate_DS_LoseRatio}"/>
                                <GridViewColumn HeaderTemplate="{StaticResource GridViewHeader_DS_Draw}" CellTemplate="{StaticResource ItemTemplate_DS_Draw}"/>
                                <GridViewColumn HeaderTemplate="{StaticResource GridViewHeader_DS_DrawRatio}" CellTemplate="{StaticResource ItemTemplate_DS_DrawRatio}"/>
                                <GridViewColumn HeaderTemplate="{StaticResource GridViewHeader_DS_DiscWin}" CellTemplate="{StaticResource ItemTemplate_DS_DiscWin}"/>
                                <GridViewColumn HeaderTemplate="{StaticResource GridViewHeader_DS_DiscWinRatio}" CellTemplate="{StaticResource ItemTemplate_DS_DiscWinRatio}"/>
                                <GridViewColumn HeaderTemplate="{StaticResource GridViewHeader_DS_DiscLose}" CellTemplate="{StaticResource ItemTemplate_DS_DiscLose}"/>
                                <GridViewColumn HeaderTemplate="{StaticResource GridViewHeader_DS_DiscLoseRatio}" CellTemplate="{StaticResource ItemTemplate_DS_DiscLoseRatio}"/>
                                <GridViewColumn HeaderTemplate="{StaticResource GridViewHeader_DS_WinLike}" CellTemplate="{StaticResource ItemTemplate_DS_WinLike}"/>
                                <GridViewColumn HeaderTemplate="{StaticResource GridViewHeader_DS_WinLikeRatio}" CellTemplate="{StaticResource ItemTemplate_DS_WinLikeRatio}"/>
                                <GridViewColumn HeaderTemplate="{StaticResource GridViewHeader_DS_First}" CellTemplate="{StaticResource ItemTemplate_DS_First}"/>
                                <GridViewColumn HeaderTemplate="{StaticResource GridViewHeader_DS_FirstRatio}" CellTemplate="{StaticResource ItemTemplate_DS_FirstRatio}"/>
                                <GridViewColumn HeaderTemplate="{StaticResource GridViewHeader_DS_Second}" CellTemplate="{StaticResource ItemTemplate_DS_Second}"/>
                                <GridViewColumn HeaderTemplate="{StaticResource GridViewHeader_DS_SecondRatio}" CellTemplate="{StaticResource ItemTemplate_DS_SecondRatio}"/>
                                <GridViewColumn HeaderTemplate="{StaticResource GridViewHeader_DS_CFirst}" CellTemplate="{StaticResource ItemTemplate_DS_CFirst}"/>
                                <GridViewColumn HeaderTemplate="{StaticResource GridViewHeader_DS_CFirstRatio}" CellTemplate="{StaticResource ItemTemplate_DS_CFirstRatio}"/>
                                <GridViewColumn HeaderTemplate="{StaticResource GridViewHeader_DS_CSecond}" CellTemplate="{StaticResource ItemTemplate_DS_CSecond}"/>
                                <GridViewColumn HeaderTemplate="{StaticResource GridViewHeader_DS_CSecondRatio}" CellTemplate="{StaticResource ItemTemplate_DS_CSecondRatio}"/>
                                <GridViewColumn HeaderTemplate="{StaticResource GridViewHeader_DS_FirstWin}" CellTemplate="{StaticResource ItemTemplate_DS_FirstWin}"/>
                                <GridViewColumn HeaderTemplate="{StaticResource GridViewHeader_DS_FirstWinRatio}" CellTemplate="{StaticResource ItemTemplate_DS_FirstWinRatio}"/>
                                <GridViewColumn HeaderTemplate="{StaticResource GridViewHeader_DS_SecondWin}" CellTemplate="{StaticResource ItemTemplate_DS_SecondWin}"/>
                                <GridViewColumn HeaderTemplate="{StaticResource GridViewHeader_DS_SecondWinRatio}" CellTemplate="{StaticResource ItemTemplate_DS_SecondWinRatio}"/>
                                <GridViewColumn HeaderTemplate="{StaticResource GridViewHeader_DS_CFirstWin}" CellTemplate="{StaticResource ItemTemplate_DS_CFirstWin}"/>
                                <GridViewColumn HeaderTemplate="{StaticResource GridViewHeader_DS_CFirstWinRatio}" CellTemplate="{StaticResource ItemTemplate_DS_CFirstWinRatio}"/>
                                <GridViewColumn HeaderTemplate="{StaticResource GridViewHeader_DS_CSecondWin}" CellTemplate="{StaticResource ItemTemplate_DS_CSecondWin}"/>
                                <GridViewColumn HeaderTemplate="{StaticResource GridViewHeader_DS_CSecondWinRatio}" CellTemplate="{StaticResource ItemTemplate_DS_CSecondWinRatio}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </TabItem>
                <TabItem Header="{Binding DLog.Tab_TagSingle.Value, Source={x:Static yw:Vocab.Current}}">
                    <ListView x:Name="ListView_DeckTagSingle" ItemsSource="{Binding Statistics.DeckTagSingle}">
                        <ListView.View>
                            <GridView AllowsColumnReorder="False">
                                <GridViewColumn HeaderTemplate="{StaticResource GridViewHeader_DS_Tag}" CellTemplate="{StaticResource ItemTemplate_DS_Tag}"/>
                                <GridViewColumn HeaderTemplate="{StaticResource GridViewHeader_DS_Count}" CellTemplate="{StaticResource ItemTemplate_DS_Count}"/>
                                <GridViewColumn HeaderTemplate="{StaticResource GridViewHeader_DS_CountRatio}" CellTemplate="{StaticResource ItemTemplate_DS_CountRatio}"/>
                                <GridViewColumn HeaderTemplate="{StaticResource GridViewHeader_DS_Win}" CellTemplate="{StaticResource ItemTemplate_DS_Win}"/>
                                <GridViewColumn HeaderTemplate="{StaticResource GridViewHeader_DS_WinRatio}" CellTemplate="{StaticResource ItemTemplate_DS_WinRatio}"/>
                                <GridViewColumn HeaderTemplate="{StaticResource GridViewHeader_DS_Lose}" CellTemplate="{StaticResource ItemTemplate_DS_Lose}"/>
                                <GridViewColumn HeaderTemplate="{StaticResource GridViewHeader_DS_LoseRatio}" CellTemplate="{StaticResource ItemTemplate_DS_LoseRatio}"/>
                                <GridViewColumn HeaderTemplate="{StaticResource GridViewHeader_DS_Draw}" CellTemplate="{StaticResource ItemTemplate_DS_Draw}"/>
                                <GridViewColumn HeaderTemplate="{StaticResource GridViewHeader_DS_DrawRatio}" CellTemplate="{StaticResource ItemTemplate_DS_DrawRatio}"/>
                                <GridViewColumn HeaderTemplate="{StaticResource GridViewHeader_DS_DiscWin}" CellTemplate="{StaticResource ItemTemplate_DS_DiscWin}"/>
                                <GridViewColumn HeaderTemplate="{StaticResource GridViewHeader_DS_DiscWinRatio}" CellTemplate="{StaticResource ItemTemplate_DS_DiscWinRatio}"/>
                                <GridViewColumn HeaderTemplate="{StaticResource GridViewHeader_DS_DiscLose}" CellTemplate="{StaticResource ItemTemplate_DS_DiscLose}"/>
                                <GridViewColumn HeaderTemplate="{StaticResource GridViewHeader_DS_DiscLoseRatio}" CellTemplate="{StaticResource ItemTemplate_DS_DiscLoseRatio}"/>
                                <GridViewColumn HeaderTemplate="{StaticResource GridViewHeader_DS_WinLike}" CellTemplate="{StaticResource ItemTemplate_DS_WinLike}"/>
                                <GridViewColumn HeaderTemplate="{StaticResource GridViewHeader_DS_WinLikeRatio}" CellTemplate="{StaticResource ItemTemplate_DS_WinLikeRatio}"/>
                                <GridViewColumn HeaderTemplate="{StaticResource GridViewHeader_DS_First}" CellTemplate="{StaticResource ItemTemplate_DS_First}"/>
                                <GridViewColumn HeaderTemplate="{StaticResource GridViewHeader_DS_FirstRatio}" CellTemplate="{StaticResource ItemTemplate_DS_FirstRatio}"/>
                                <GridViewColumn HeaderTemplate="{StaticResource GridViewHeader_DS_Second}" CellTemplate="{StaticResource ItemTemplate_DS_Second}"/>
                                <GridViewColumn HeaderTemplate="{StaticResource GridViewHeader_DS_SecondRatio}" CellTemplate="{StaticResource ItemTemplate_DS_SecondRatio}"/>
