                            </GridView>
                        </ListView.View>
                    </ListView>
                </TabItem>
                <TabItem Header="{Binding DLog.Tab_InitialHand.Value, Source={x:Static yw:Vocab.Current}}">
                    <ListView x:Name="ListView_InitialHand" ItemsSource="{Binding Statistics.InitialHand}">
