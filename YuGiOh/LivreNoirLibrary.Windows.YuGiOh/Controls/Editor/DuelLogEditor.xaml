<local:DuelLogEditor_Base x:Class="LivreNoirLibrary.Windows.YuGiOh.Controls.DuelLogEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:LivreNoirLibrary.Windows.YuGiOh.Controls"
             xmlns:ct="clr-namespace:LivreNoirLibrary.Windows.Controls;assembly=LivreNoirLibrary.Windows.Controls"
             xmlns:media="clr-namespace:LivreNoirLibrary.Windows.Media;assembly=LivreNoirLibrary.Windows.Media"
             xmlns:yw="clr-namespace:LivreNoirLibrary.Windows.YuGiOh;assembly=LivreNoirLibrary.Windows.YuGiOh"
             xmlns:ygo="clr-namespace:LivreNoirLibrary.YuGiOh.Data;assembly=LivreNoirLibrary.YuGiOh.Core"
             xmlns:ys="clr-namespace:LivreNoirLibrary.YuGiOh.Search;assembly=LivreNoirLibrary.YuGiOh.Core"
             xmlns:ymd="clr-namespace:LivreNoirLibrary.YuGiOh.MasterDuel;assembly=LivreNoirLibrary.YuGiOh.Core"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/LivreNoirLibrary.Windows.YuGiOh;component/Themes/Generic.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid x:Name="MainGrid" d:DataContext="{d:DesignInstance Type=local:DuelLogEditor}" ColumnDefinitions="3*, 2*">
        <Grid RowDefinitions="Auto, 4, *" ColumnDefinitions="*, Auto">
            <Grid ColumnDefinitions="*, Auto">
                <StackPanel Style="{StaticResource EditBarStackPanel}">
                    <ct:Button Style="{StaticResource IconButton_Undo}"/>
                    <ct:Button Style="{StaticResource IconButton_Redo}"/>
                    <Rectangle Width="8"/>
                    <ct:Button Style="{StaticResource IconButton_AllClear}"/>
                    <ct:Button Style="{StaticResource IconButton_Open}"/>
                    <ct:Button Style="{StaticResource IconButton_Save}"/>
                </StackPanel>
                <ct:Button Grid.Column="1" Style="{StaticResource IconButton_Delete}" CommandTarget="{Binding ElementName=ListView_Main}"/>
            </Grid>
            <ListView x:Name="ListView_Main" Grid.Row="2" Style="{StaticResource Alt2ListBoxStyle}" ItemsSource="{Binding ItemsSource}" SelectionMode="Single" ScrollViewer.HorizontalScrollBarVisibility="Auto" SelectionChanged="OnSelectionChanged">
                <ListView.Resources>
                    <Style TargetType="GridViewColumnHeader">
                        <EventSetter Event="Click" Handler="OnClick_ColumnHeader" />
                    </Style>
                </ListView.Resources>
                <ListView.View>
                    <GridView>
                        <GridViewColumn HeaderTemplate="{StaticResource GridViewHeader_DateTime}" CellTemplate="{StaticResource ItemTemplate_DateTime}"/>
                        <GridViewColumn HeaderTemplate="{StaticResource GridViewHeader_Rank}" CellTemplate="{StaticResource ItemTemplate_Rank}"/>
                        <GridViewColumn HeaderTemplate="{StaticResource GridViewHeader_Order}" CellTemplate="{StaticResource ItemTemplate_Order}"/>
                        <GridViewColumn HeaderTemplate="{StaticResource GridViewHeader_Turn}" CellTemplate="{StaticResource ItemTemplate_Turn}"/>
                        <GridViewColumn HeaderTemplate="{StaticResource GridViewHeader_Result}" CellTemplate="{StaticResource ItemTemplate_Result}"/>
                        <GridViewColumn HeaderTemplate="{StaticResource GridViewHeader_User}" CellTemplate="{StaticResource ItemTemplate_User}"/>
                        <GridViewColumn HeaderTemplate="{StaticResource GridViewHeader_Opponent}" CellTemplate="{StaticResource ItemTemplate_Opponent}"/>
                        <GridViewColumn HeaderTemplate="{StaticResource GridViewHeader_Note}" CellTemplate="{StaticResource ItemTemplate_Note}"/>
                    </GridView>
                </ListView.View>
            </ListView>
            <Grid Grid.Row="2" Grid.Column="1" RowDefinitions="*, *, *">
                <ct:Button Style="{StaticResource LargeButton_Blue}" Click="OnClick_Add">
                    <StackPanel Style="{StaticResource LargeButtonStackPanel}">
                        <ct:IconPresenter Style="{StaticResource LargeButtonIcon}" Source="{x:Static media:Icons.ArrowLeft}"/>
                        <ct:VerticalTextBlock Text="{Binding Add.Value, Source={x:Static yw:Vocab.Current}}"/>
                    </StackPanel>
                </ct:Button>
                <ct:Button Style="{StaticResource LargeButton_Green}" Click="OnClick_Save" IsEnabled="{Binding SelectedItem, ElementName=ListView_Main, Converter={StaticResource BooleanConverter}}">
                    <StackPanel Style="{StaticResource LargeButtonStackPanel}">
                        <ct:IconPresenter Style="{StaticResource LargeButtonIcon}" Source="{x:Static media:Icons.ArrowLeft}"/>
                        <ct:VerticalTextBlock Text="{Binding Save.Value, Source={x:Static yw:Vocab.Current}}"/>
                    </StackPanel>
                </ct:Button>
                <ct:Button Style="{StaticResource LargeButton_Red}" Click="OnClick_Load" IsEnabled="{Binding SelectedItem, ElementName=ListView_Main, Converter={StaticResource BooleanConverter}}">
                    <StackPanel Style="{StaticResource LargeButtonStackPanel}">
                        <ct:IconPresenter Style="{StaticResource LargeButtonIcon}" Source="{x:Static media:Icons.ArrowRight}"/>
                        <ct:VerticalTextBlock Text="{Binding Reload.Value, Source={x:Static yw:Vocab.Current}}"/>
                    </StackPanel>
                </ct:Button>
            </Grid>
        </Grid>
        <Grid Grid.Column="2" RowDefinitions="Auto, *">
            <Grid.Resources>
                <Style TargetType="ComboBox" BasedOn="{StaticResource ComboBoxBase}">
                    <Setter Property="BorderBrush" Value="Transparent"/>
                    <EventSetter Event="PreviewMouseWheel" Handler="OnMouseWheel_ComboBox"/>
                    <Setter Property="ItemTemplate">
                        <Setter.Value>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name.Value}"/>
                            </DataTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Grid.Resources>
            <Grid x:Name="InfoView" ColumnDefinitions="Auto, *, Auto, *" RowDefinitions="Auto, Auto, Auto, Auto, Auto">
                <Label Grid.Row="0" Grid.Column="0" Style="{StaticResource Label_Header}" Content="{Binding DLog.DateTime.Value, Source={x:Static yw:Vocab.Current}}"/>
                <ct:DateTimePicker Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" SelectedDateTime="{Binding EditingLog.DateTime}"/>
                <ct:Button Grid.Row="0" Grid.Column="3" Style="{StaticResource IconButton_AllClear}" HorizontalAlignment="Right" Icon="{x:Static media:Icons.Cross_Red}"/>

                <Label Grid.Row="1" Grid.Column="0" Style="{StaticResource Label_Header}" Content="{Binding DLog.User.Value, Source={x:Static yw:Vocab.Current}}"/>
                <local:DeckTagSelector Grid.Row="1" Grid.Column="1" x:Name="UserSelector" ItemsSource="{Binding DeckTagSource}" SelectedItemChanged="User_TagChanged"/>
                <Label Grid.Row="1" Grid.Column="2" Style="{StaticResource Label_Header}" Content="{Binding DLog.Opponent.Value, Source={x:Static yw:Vocab.Current}}"/>
                <local:DeckTagSelector Grid.Row="1" Grid.Column="3" x:Name="OpponentSelector" ItemsSource="{Binding DeckTagSource}" SelectedItemChanged="Opponent_TagChanged"/>

                <Label Grid.Row="2" Grid.Column="0" Style="{StaticResource Label_Header}" Content="{Binding DLog.Rank.Value, Source={x:Static yw:Vocab.Current}}"/>
                <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{x:Static local:RankItem.Items}" SelectedItem="{Binding EditingLog.Rank, Converter={StaticResource CIConv}}">
                    <ComboBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Grid ColumnDefinitions="Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto" RowDefinitions="Auto, Auto, Auto, Auto, Auto"/>
                        </ItemsPanelTemplate>
                    </ComboBox.ItemsPanel>
                    <ComboBox.ItemContainerStyle>
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="MinWidth" Value="36"/>
                            <Setter Property="Grid.Column" Value="{Binding Column}"/>
                            <Setter Property="Grid.Row" Value="{Binding Row}"/>
                            <Setter Property="Background" Value="{Binding Background}"/>
                        </Style>
                    </ComboBox.ItemContainerStyle>
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <Label Grid.Row="2" Grid.Column="2" Style="{StaticResource Label_Header}" Content="{Binding DLog.Order.Value, Source={x:Static yw:Vocab.Current}}"/>
                <ComboBox Grid.Row="2" Grid.Column="3" ItemsSource="{x:Static local:OrderItem.Items}" SelectedItem="{Binding EditingLog.Order, Converter={StaticResource CIConv}}"/>

                <Label Grid.Row="3" Grid.Column="0" Style="{StaticResource Label_Header}" Content="{Binding DLog.Turn.Value, Source={x:Static yw:Vocab.Current}}"/>
                <ct:LabeledSlider Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="99" TickFrequency="1" Value="{Binding EditingLog.Turn}" Margin="4,0" IsTextEditable="True" TextWidth="28"/>

                <Label Grid.Row="3" Grid.Column="2" Style="{StaticResource Label_Header}" Content="{Binding DLog.Result.Value, Source={x:Static yw:Vocab.Current}}"/>
                <ComboBox Grid.Row="3" Grid.Column="3" ItemsSource="{x:Static local:ResultItem.Items}" SelectedItem="{Binding EditingLog.Result, Converter={StaticResource CIConv}}"/>

                <Label Grid.Row="4" Grid.Column="0" Style="{StaticResource Label_Header}" Content="{Binding DLog.Note.Value, Source={x:Static yw:Vocab.Current}}"/>
                <TextBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3" Margin="2" Text="{Binding EditingLog.Note, Mode=TwoWay}"/>
            </Grid>
            <Grid Grid.Row="1" ColumnDefinitions="*, Auto, *">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*" MaxHeight="129"/>
                    <RowDefinition Height="*" MaxHeight="4"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.Resources>
                    <Style x:Key="ListViewItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource Alt2ListBoxItemContainerStyle}">
                        <EventSetter Event="PreviewMouseLeftButtonDown" Handler="ListViewItem_PreviewMouseLeftButtonDown"/>
                        <EventSetter Event="PreviewMouseMove" Handler="IDragDrop_PreviewMouseMove"/>
                        <EventSetter Event="PreviewMouseRightButtonDown" Handler="OnMouseRightButtonDown"/>
                        <EventSetter Event="PreviewMouseRightButtonUp" Handler="OnMouseRightButtonUp"/>
                    </Style>
                    <Style TargetType="ListView" x:Key="ListViewStyle" BasedOn="{StaticResource Alt2ListBoxStyle}">
                        <Setter Property="AllowDrop" Value="True"/>
                        <Setter Property="ItemContainerStyle" Value="{StaticResource ListViewItemStyle}"/>
                        <Setter Property="SelectionMode" Value="Extended"/>
                        <EventSetter Event="DragOver" Handler="IDragDrop_DragOver"/>
                        <EventSetter Event="Drop" Handler="IDragDrop_Drop"/>
                    </Style>
                    <Style TargetType="ListView" BasedOn="{StaticResource ListViewStyle}"/>
                </Grid.Resources>
                <Label Grid.Row="0" Style="{StaticResource Label_Header}" HorizontalAlignment="Left" Content="{Binding DLog.InitialHand.Value, Source={x:Static yw:Vocab.Current}}"/>
                <ListView Grid.Row="1" x:Name="ListView_InitialHand" ItemsSource="{Binding InitialHandList}" ItemTemplate="{StaticResource ItemTemplate_Name}"/>
                <ct:Button Grid.Column="1" Style="{StaticResource IconButton_ListClear}" Click="OnClick_Hand_Clear"/>

                <Label Grid.Row="3" Style="{StaticResource Label_Header}" HorizontalAlignment="Left" Content="{Binding DLog.AdditionalHand.Value, Source={x:Static yw:Vocab.Current}}"/>
                <ListView Grid.Row="4" x:Name="ListView_AdditionalHand" ItemsSource="{Binding AdditionalHandList}" ItemTemplate="{StaticResource ItemTemplate_Name}"/>

                <Grid Grid.Column="1" Grid.Row="1" RowDefinitions="*, *">
                    <ct:Button Style="{StaticResource LargeButton_Blue}" Icon="{x:Static media:Icons.ArrowLeft}" ToolTip="{Binding Add.Value, Source={x:Static yw:Vocab.Current}}" Click="OnClick_Initial_Add" IsEnabled="{Binding CanAddCard}"/>
                    <ct:Button Style="{StaticResource LargeButton_Red}" Icon="{x:Static media:Icons.ArrowRight}" ToolTip="{Binding Delete.Value, Source={x:Static yw:Vocab.Current}}" Click="OnClick_Initial_Remove" IsEnabled="{Binding SelectedItems.Count, ElementName=ListView_InitialHand, Converter={StaticResource BooleanConverter}}"/>
                </Grid>
                <Grid Grid.Column="1" Grid.Row="4" RowDefinitions="*, *">
                    <ct:Button Style="{StaticResource LargeButton_Blue}" Icon="{x:Static media:Icons.ArrowLeft}" ToolTip="{Binding Add.Value, Source={x:Static yw:Vocab.Current}}" Click="OnClick_Additional_Add" IsEnabled="{Binding CanAddCard}"/>
                    <ct:Button Style="{StaticResource LargeButton_Red}" Icon="{x:Static media:Icons.ArrowRight}" ToolTip="{Binding Delete.Value, Source={x:Static yw:Vocab.Current}}" Click="OnClick_Additional_Remove" IsEnabled="{Binding SelectedItems.Count, ElementName=ListView_AdditionalHand, Converter={StaticResource BooleanConverter}}"/>
                </Grid>
                <TabControl Grid.Column="2" Grid.RowSpan="5" Padding="-1" SelectionChanged="CardSource_SelectionChanged">
                    <TabControl.Resources>
                        <Style TargetType="ListView" BasedOn="{StaticResource ListViewStyle}">
                            <EventSetter Event="GotFocus" Handler="CardSource_GotFocus"/>
                            <EventSetter Event="SelectionChanged" Handler="CardSource_SelectionChanged"/>
                        </Style>
                    </TabControl.Resources>
                    <TabItem x:Name="TabItem_Deck" Header="{Binding DLog.Deck.Value, Source={x:Static yw:Vocab.Current}}">
                        <ListView x:Name="ListView_DeckCards" ItemsSource="{Binding DeckCards}" ItemTemplate="{StaticResource ItemTemplate_FullText}"/>
                    </TabItem>
                    <TabItem Header="{Binding DLog.AllCards.Value, Source={x:Static yw:Vocab.Current}}">
                        <Grid RowDefinitions="Auto, 2, *">
                            <local:CardSearchBar Margin="3,3,3,0" ListBox="{Binding ElementName=ListView_AllCards}" CanOpenSearchDialog="false" DefaultSearchConditions="{Binding DefaultCardSearchConditions}"/>
                            <ListView Grid.Row="2" x:Name="ListView_AllCards" ItemTemplate="{StaticResource ItemTemplate_FullText}"/>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>
    </Grid>
</local:DuelLogEditor_Base>
