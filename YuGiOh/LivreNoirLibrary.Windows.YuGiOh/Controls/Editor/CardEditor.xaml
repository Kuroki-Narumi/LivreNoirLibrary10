<local:CardEditor_Base x:Class="LivreNoirLibrary.Windows.YuGiOh.Controls.CardEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:LivreNoirLibrary.Windows.YuGiOh.Controls"
             xmlns:ct="clr-namespace:LivreNoirLibrary.Windows.Controls;assembly=LivreNoirLibrary.Windows.Controls"
             xmlns:media="clr-namespace:LivreNoirLibrary.Windows.Media;assembly=LivreNoirLibrary.Windows.Media"
             xmlns:yw="clr-namespace:LivreNoirLibrary.Windows.YuGiOh;assembly=LivreNoirLibrary.Windows.YuGiOh"
             xmlns:ygo="clr-namespace:LivreNoirLibrary.YuGiOh.Data;assembly=LivreNoirLibrary.YuGiOh.Core"
             xmlns:yg="clr-namespace:LivreNoirLibrary.YuGiOh;assembly=LivreNoirLibrary.YuGiOh.Core"
             xmlns:input="clr-namespace:LivreNoirLibrary.Windows.Input;assembly=LivreNoirLibrary.Windows.Core"
             mc:Ignorable="d" Background="White"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/LivreNoirLibrary.Windows.YuGiOh;component/Themes/Generic.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid ColumnDefinitions="2*, 5*">
        <Grid RowDefinitions="Auto, 4, *, 2, Auto" ColumnDefinitions="*, Auto">
            <StackPanel Style="{StaticResource EditBarStackPanel}">
                <ct:Button Style="{StaticResource IconButton_Undo}"/>
                <ct:Button Style="{StaticResource IconButton_Redo}"/>
                <Rectangle Width="8"/>
                <ct:Button Style="{StaticResource IconButton_AllClear}"/>
                <ct:Button Style="{StaticResource IconButton_Open}"/>
                <ct:Button Style="{StaticResource IconButtonBase}" Icon="{x:Static media:Icons.Merge}" ToolTip="{Binding Merge.Value, Source={x:Static yw:Vocab.Current}}" Click="OnClick_Merge"/>
                <ct:Button Style="{StaticResource IconButton_Save}"/>
            </StackPanel>
            <ListView x:Name="ListView_CardList" Grid.Row="2" Style="{StaticResource CardListView}">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource Alt2ListBoxItemContainerStyle}">
                        <Setter Property="ContextMenu">
                            <Setter.Value>
                                <ContextMenu>
                                    <MenuItem Style="{StaticResource MenuItem_Add}"/>
                                    <MenuItem Style="{StaticResource MenuItem_MoveUp}"/>
                                    <MenuItem Style="{StaticResource MenuItem_MoveDown}"/>
                                    <MenuItem Style="{StaticResource MenuItem_Delete}"/>
                                    <Separator/>
                                    <MenuItem Style="{StaticResource MenuItem_Cut}"/>
                                    <MenuItem Style="{StaticResource MenuItem_Copy}"/>
                                    <MenuItem Style="{StaticResource MenuItem_Paste}"/>
                                    <MenuItem Style="{StaticResource MenuItem_Duplicate}"/>
                                </ContextMenu>
                            </Setter.Value>
                        </Setter>
                        <EventSetter Event="PreviewMouseLeftButtonDown" Handler="CardListView_PreviewMouseLeftButtonDown"/>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ContextMenu>
                    <ContextMenu>
                        <MenuItem Style="{StaticResource MenuItem_Add}" CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <MenuItem Style="{StaticResource MenuItem_Paste}" CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                    </ContextMenu>
                </ListView.ContextMenu>
            </ListView>
            <Grid Grid.Row="4" Style="{StaticResource EditBarPanel}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="8"/>
                    <ColumnDefinition Width="*" MinWidth="22"/>
                    <ColumnDefinition Width="*" MinWidth="22"/>
                    <ColumnDefinition Width="*" MinWidth="22"/>
                    <ColumnDefinition Width="*" MinWidth="22"/>
                    <ColumnDefinition Width="*" MaxWidth="8"/>
                    <ColumnDefinition Width="*" MinWidth="22"/>
                    <ColumnDefinition Width="*" MinWidth="22"/>
                    <ColumnDefinition Width="*" MinWidth="22"/>
                    <ColumnDefinition Width="*" MinWidth="22"/>
                    <ColumnDefinition Width="*" MaxWidth="8"/>
                </Grid.ColumnDefinitions>
                <ct:Button Grid.Column="1" Style="{StaticResource IconButton_Add}" CommandTarget="{Binding ElementName=ListView_CardList}"/>
                <ct:Button Grid.Column="2" Style="{StaticResource IconButton_MoveUp}" CommandTarget="{Binding ElementName=ListView_CardList}"/>
                <ct:Button Grid.Column="3" Style="{StaticResource IconButton_MoveDown}" CommandTarget="{Binding ElementName=ListView_CardList}"/>
                <ct:Button Grid.Column="4" Style="{StaticResource IconButton_Delete}" CommandTarget="{Binding ElementName=ListView_CardList}"/>
                <ct:Button Grid.Column="6" Style="{StaticResource IconButton_Cut}" CommandTarget="{Binding ElementName=ListView_CardList}"/>
                <ct:Button Grid.Column="7" Style="{StaticResource IconButton_Copy}" CommandTarget="{Binding ElementName=ListView_CardList}"/>
                <ct:Button Grid.Column="8" Style="{StaticResource IconButton_Paste}" CommandTarget="{Binding ElementName=ListView_CardList}"/>
                <ct:Button Grid.Column="9" Style="{StaticResource IconButton_Duplicate}" CommandTarget="{Binding ElementName=ListView_CardList}"/>
            </Grid>
            <Grid Grid.Row="2" Grid.Column="1" RowDefinitions="*, *" IsEnabled="{Binding SelectedItem, ElementName=ListView_CardList, Converter={StaticResource BooleanConverter}}">
                <ct:Button Style="{StaticResource LargeButton_Blue}" Click="OnClick_Apply">
                    <StackPanel Style="{StaticResource LargeButtonStackPanel}">
                        <ct:IconPresenter Style="{StaticResource LargeButtonIcon}" Source="{x:Static media:Icons.ArrowLeft}"/>
                        <ct:VerticalTextBlock Text="{Binding Save.Value, Source={x:Static yw:Vocab.Current}}"/>
                    </StackPanel>
                </ct:Button>
                <ct:Button Style="{StaticResource LargeButton_Red}" Click="OnClick_Load">
                    <StackPanel Style="{StaticResource LargeButtonStackPanel}">
                        <ct:IconPresenter Style="{StaticResource LargeButtonIcon}" Source="{x:Static media:Icons.ArrowRight}"/>
                        <ct:VerticalTextBlock Text="{Binding Reload.Value, Source={x:Static yw:Vocab.Current}}"/>
                    </StackPanel>
                </ct:Button>
            </Grid>
        </Grid>
        <local:CardInfoEditor x:Name="CardInfoEditor" Grid.Column="2" Source="{Binding SelectedItem, ElementName=ListView_CardList}"/>
    </Grid>
</local:CardEditor_Base>
