<local:RegulationEditor_Base x:Class="LivreNoirLibrary.Windows.YuGiOh.Controls.RegulationEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:LivreNoirLibrary.Windows.YuGiOh.Controls"
             xmlns:ct="clr-namespace:LivreNoirLibrary.Windows.Controls;assembly=LivreNoirLibrary.Windows.Controls"
             xmlns:media="clr-namespace:LivreNoirLibrary.Windows.Media;assembly=LivreNoirLibrary.Windows.Media"
             xmlns:yw="clr-namespace:LivreNoirLibrary.Windows.YuGiOh;assembly=LivreNoirLibrary.Windows.YuGiOh"
             xmlns:ygo="clr-namespace:LivreNoirLibrary.YuGiOh.Data;assembly=LivreNoirLibrary.YuGiOh.Core"
             xmlns:yg="clr-namespace:LivreNoirLibrary.YuGiOh;assembly=LivreNoirLibrary.YuGiOh.Core"
             mc:Ignorable="d"  Background="White"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/LivreNoirLibrary.Windows.YuGiOh;component/Themes/Generic.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <ContextMenu x:Key="ContextMenu_Regulation">
                <MenuItem Header="{Binding Limit.Forbidden.MenuHeader, Source={x:Static yw:Vocab.Current}}" Click="ContextMenu_OnClick_Forbidden">
                    <MenuItem.Icon>
                        <ct:IconPresenter Height="16" Source="{x:Static local:Icons.Forbidden}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{Binding Limit.Limit1.MenuHeader, Source={x:Static yw:Vocab.Current}}" Click="ContextMenu_OnClick_Limit1">
                    <MenuItem.Icon>
                        <ct:IconPresenter Height="16" Source="{x:Static local:Icons.Limit1}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{Binding Limit.Limit2.MenuHeader, Source={x:Static yw:Vocab.Current}}" Click="ContextMenu_OnClick_Limit2">
                    <MenuItem.Icon>
                        <ct:IconPresenter Height="16" Source="{x:Static local:Icons.Limit2}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{Binding Limit.Unlimited.MenuHeader, Source={x:Static yw:Vocab.Current}}" Click="ContextMenu_OnClick_Unlimited"/>
                <MenuItem Header="{Binding Limit.Specified.MenuHeader, Source={x:Static yw:Vocab.Current}}" Click="ContextMenu_OnClick_Specified">
                    <MenuItem.Icon>
                        <ct:IconPresenter Height="16" Source="{x:Static local:Icons.Specified}"/>
                    </MenuItem.Icon>
                </MenuItem>
            </ContextMenu>
            <Style TargetType="ListView" x:Key="ListViewStyle" BasedOn="{StaticResource CardListView_MultiSelect}">
                <Setter Property="Grid.Row" Value="2"/>
                <Setter Property="AllowDrop" Value="True"/>
                <Setter Property="ContextMenu" Value="{StaticResource ContextMenu_Regulation}"/>
                <Setter Property="ItemContainerStyle">
                    <Setter.Value>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource Alt2ListBoxItemContainerStyle}">
                            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="ListView_PreviewMouseLeftButtonDown"/>
                            <EventSetter Event="PreviewMouseMove" Handler="IDragDrop_PreviewMouseMove"/>
                        </Style>
                    </Setter.Value>
                </Setter>
                <EventSetter Event="SelectionChanged" Handler="ListView_OnSelectionChanged"/>
                <EventSetter Event="GotFocus" Handler="ListView_OnGotFocus"/>
                <EventSetter Event="DragOver" Handler="IDragDrop_DragOver"/>
                <EventSetter Event="Drop" Handler="IDragDrop_Drop"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid x:Name="MainGrid" d:DataContext="{d:DesignInstance Type=local:RegulationEditor}" ColumnDefinitions="1.5*, 4, 4*" RowDefinitions="Auto, 4, *">
        <local:CardSearchBar ListBox="{Binding ElementName=ListView_CardList}" DefaultSearchConditions="{Binding DefaultCardSearchConditions}" SortExecuted="OnCardSortExecuted"/>
        <ListView x:Name="ListView_CardList" Style="{StaticResource ListViewStyle}" ItemTemplate="{StaticResource ItemTemplate_FullTextWithLimit}"/>
        <Grid Grid.Column="2" ColumnDefinitions="*, Auto, Auto">
            <Grid.Resources>
                <Style x:Key="UpdateButton" TargetType="ct:Button">
                    <Setter Property="Margin" Value="2,0"/>
                    <Setter Property="Padding" Value="4,0"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="Icon" Value="{x:Static media:Icons.Update_Mono}"/>
                </Style>
            </Grid.Resources>
            <StackPanel Style="{StaticResource EditBarStackPanel}" Margin="4,0">
                <ct:Button Style="{StaticResource IconButton_Undo}"/>
                <ct:Button Style="{StaticResource IconButton_Redo}"/>
                <Rectangle Width="8"/>
                <ct:Button Style="{StaticResource IconButton_AllClear}"/>
                <ct:Button Style="{StaticResource IconButton_Open}"/>
                <ct:Button Style="{StaticResource IconButton_Save}"/>
            </StackPanel>
            <ct:Button Grid.Column="1" Style="{StaticResource UpdateButton}" Content="{Binding Ocg.Value, Source={x:Static yw:Vocab.Current}}" ToolTip="{Binding Desc_RegulationOcg.Value, Source={x:Static yw:Vocab.Current}}" Command="yw:YgoCommands.LoadOcgRegulation"/>
            <ct:Button Grid.Column="2" Style="{StaticResource UpdateButton}" Content="{Binding Tcg.Value, Source={x:Static yw:Vocab.Current}}" ToolTip="{Binding Desc_RegulationTcg.Value, Source={x:Static yw:Vocab.Current}}" Command="yw:YgoCommands.LoadTcgRegulation"/>
        </Grid>
        <Grid Grid.Row="2" Grid.Column="2" RowDefinitions="Auto, 4, *">
            <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto, 4, Auto, *, Auto, 4, Auto, *, Auto, 4, Auto, *, Auto">
                <Grid.Resources>
                    <Style TargetType="ct:IconPresenter">
                        <Setter Property="Height" Value="16"/>
                        <Setter Property="Margin" Value="2,0"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                    </Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="HorizontalAlignment" Value="Left"/>
                    </Style>
                    <Style TargetType="TextBlock" x:Key="Counter">
                        <Setter Property="Margin" Value="2,0"/>
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="VerticalAlignment" Value="Bottom"/>
                        <Setter Property="HorizontalAlignment" Value="Right"/>
                    </Style>
                    <Style TargetType="ct:Button" BasedOn="{StaticResource IconButton_ListClear}">
                        <Setter Property="Margin" Value="4,0,0,0"/>
                        <EventSetter Event="Click" Handler="OnClick_ClearButton"/>
                    </Style>
                </Grid.Resources>
                <ct:IconPresenter Grid.Column="0" Source="{x:Static local:Icons.Forbidden}"/>
                <ct:IconPresenter Grid.Column="4" Source="{x:Static local:Icons.Limit1}"/>
                <ct:IconPresenter Grid.Column="8" Source="{x:Static local:Icons.Limit2}"/>
                <ct:IconPresenter Grid.Column="12" Source="{x:Static local:Icons.Specified}"/>
                <TextBlock Grid.Column="1" Text="{Binding Limit.Forbidden, Source={x:Static yw:Vocab.Current}}"/>
                <TextBlock Grid.Column="5" Text="{Binding Limit.Limit1, Source={x:Static yw:Vocab.Current}}"/>
                <TextBlock Grid.Column="9" Text="{Binding Limit.Limit2, Source={x:Static yw:Vocab.Current}}"/>
                <TextBlock Grid.Column="13" Text="{Binding Limit.Specified, Source={x:Static yw:Vocab.Current}}"/>
                <TextBlock Grid.Column="1" Style="{StaticResource Counter}" Text="{Binding Items.Count, ElementName=ListView_Forbidden}"/>
                <TextBlock Grid.Column="5" Style="{StaticResource Counter}" Text="{Binding Items.Count, ElementName=ListView_Limit1}"/>
                <TextBlock Grid.Column="9" Style="{StaticResource Counter}" Text="{Binding Items.Count, ElementName=ListView_Limit2}"/>
                <TextBlock Grid.Column="13" Style="{StaticResource Counter}" Text="{Binding Items.Count, ElementName=ListView_Specified}"/>
                <ct:Button Grid.Column="2" Tag="{x:Static yg:LimitCount.Forbidden}"/>
                <ct:Button Grid.Column="6" Tag="{x:Static yg:LimitCount.Limit1}"/>
                <ct:Button Grid.Column="10" Tag="{x:Static yg:LimitCount.Limit2}"/>
                <ct:Button Grid.Column="14" Tag="{x:Static yg:LimitCount.Specified}"/>
            </Grid>
            <Grid Grid.Row="2" ColumnDefinitions="*, 4, *, 4, *, 4, *">
                <Grid.Resources>
                    <Style TargetType="ListView" BasedOn="{StaticResource ListViewStyle}">

                    </Style>
                </Grid.Resources>
                <ListView Grid.Column="0" x:Name="ListView_Forbidden" ItemsSource="{Binding Regulation.Forbidden}" Tag="{x:Static yg:LimitCount.Forbidden}"/>
                <ListView Grid.Column="2" x:Name="ListView_Limit1" ItemsSource="{Binding Regulation.Limit1}" Tag="{x:Static yg:LimitCount.Limit1}"/>
                <ListView Grid.Column="4" x:Name="ListView_Limit2" ItemsSource="{Binding Regulation.Limit2}" Tag="{x:Static yg:LimitCount.Limit2}"/>
                <ListView Grid.Column="6" x:Name="ListView_Specified" ItemsSource="{Binding Regulation.Specified}" Tag="{x:Static yg:LimitCount.Specified}"/>
            </Grid>
        </Grid>
    </Grid>
</local:RegulationEditor_Base>
