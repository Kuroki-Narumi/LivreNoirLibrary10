<UserControl x:Class="LivreNoirLibrary.Windows.YuGiOh.Controls.TrapMonsterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:LivreNoirLibrary.Windows.YuGiOh.Controls"
             xmlns:ct="clr-namespace:LivreNoirLibrary.Windows.Controls;assembly=LivreNoirLibrary.Windows.Controls"
             xmlns:media="clr-namespace:LivreNoirLibrary.Windows.Media;assembly=LivreNoirLibrary.Windows.Media"
             xmlns:yw="clr-namespace:LivreNoirLibrary.Windows.YuGiOh;assembly=LivreNoirLibrary.Windows.YuGiOh"
             xmlns:ygo="clr-namespace:LivreNoirLibrary.YuGiOh.Data;assembly=LivreNoirLibrary.YuGiOh.Core"
             xmlns:yg="clr-namespace:LivreNoirLibrary.YuGiOh;assembly=LivreNoirLibrary.YuGiOh.Core"
             xmlns:input="clr-namespace:LivreNoirLibrary.Windows.Input;assembly=LivreNoirLibrary.Windows.Core"
             mc:Ignorable="d" Background="White"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/LivreNoirLibrary.Windows.YuGiOh;component/Themes/Generic.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="TextBox" BasedOn="{StaticResource TextBox_CardInfo}"/>
            <Style x:Key="TextBox_Text" TargetType="TextBox" BasedOn="{StaticResource TextBox_Scrollable}">
                <Setter Property="Margin" Value="0"/>
            </Style>
            <Style TargetType="Label" BasedOn="{StaticResource Label_Header}"/>
            <Style TargetType="TextBlock">
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="4,0"/>
            </Style>
            <Style TargetType="ct:IconPresenter">
                <Setter Property="Height" Value="16"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style x:Key="CopyButton" TargetType="ct:Button" BasedOn="{StaticResource CardInfo_CopyButton}">
                <EventSetter Event="Click" Handler="OnClick_Copy"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid ColumnDefinitions="2*, 4, 1*">
        <Grid RowDefinitions="Auto, 4, *">
            <Grid ColumnDefinitions="Auto, 4, *">
                <ct:Button Style="{StaticResource RefreshButton}"/>
                <local:CardSearchBar Grid.Column="2" ListBox="{Binding ElementName=ListView_Main}" CanOpenSearchDialog="False"/>
            </Grid>
            <ListView x:Name="ListView_Main" Grid.Row="2" Style="{StaticResource CardListView}">
                <ListView.View>
                    <GridView>
                        <GridViewColumn HeaderTemplate="{StaticResource GridViewHeader_Name}" CellTemplate="{StaticResource ItemTemplate_NameWithLimit}"/>
                        <GridViewColumn HeaderTemplate="{StaticResource GridViewHeader_CardType}" CellTemplate="{StaticResource ItemTemplate_CardType}"/>
                        <GridViewColumn HeaderTemplate="{StaticResource GridViewHeader_Attribute}" CellTemplate="{StaticResource ItemTemplate_Attribute}"/>
                        <GridViewColumn Width="96" HeaderTemplate="{StaticResource GridViewHeader_MonsterType}" CellTemplate="{StaticResource ItemTemplate_MonsterType}"/>
                        <GridViewColumn Width="28" HeaderTemplate="{StaticResource GridViewHeader_Level}" CellTemplate="{StaticResource ItemTemplate_Level}"/>
                        <GridViewColumn Width="48" HeaderTemplate="{StaticResource GridViewHeader_Atk}" CellTemplate="{StaticResource ItemTemplate_Atk}"/>
                        <GridViewColumn Width="48" HeaderTemplate="{StaticResource GridViewHeader_Def}" CellTemplate="{StaticResource ItemTemplate_Def}"/>
                        <GridViewColumn Width="26" HeaderTemplate="{StaticResource GridViewHeader_Effect}" CellTemplate="{StaticResource ItemTemplate_Effect}"/>
                        <GridViewColumn Width="26" HeaderTemplate="{StaticResource GridViewHeader_Tuner}" CellTemplate="{StaticResource ItemTemplate_Tuner}"/>
                        <GridViewColumn HeaderTemplate="{StaticResource GridViewHeader_Details}" CellTemplate="{StaticResource ItemTemplate_Detail}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </Grid>
        <Grid Grid.Column="2" d:DataContext="{d:DesignInstance Type=ygo:Card}" DataContext="{Binding SelectedItem, ElementName=ListView_Main}" RowDefinitions="Auto, Auto, Auto, *, 135">
            <Grid.Resources>
                <Style TargetType="TextBox">
                    <Setter Property="Margin" Value="2,2,0,2"/>
                    <Setter Property="Padding" Value="2"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Setter Property="Grid.Column" Value="2"/>
                </Style>
                <Style x:Key="TextBox_Text" TargetType="TextBox" BasedOn="{StaticResource TextBox_Scrollable}">
                    <Setter Property="Margin" Value="0"/>
                </Style>
                <Style TargetType="Label" BasedOn="{StaticResource Label_Header}"/>
                <Style TargetType="TextBlock">
                    <Setter Property="HorizontalAlignment" Value="Left"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="Margin" Value="4,0"/>
                </Style>
            </Grid.Resources>
            <!-- card name -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto, Auto, *" RowDefinitions="Auto, Auto, Auto">
                <Label Grid.Row="0" Content="{Binding CInfo.Name.Value, Source={x:Static yw:Vocab.Current}}"/>
                <ct:Button Grid.Row="0" Style="{StaticResource CopyButton}" Tag="{Binding ElementName=TextBox_Name}"/>
                <TextBox Grid.Row="0" x:Name="TextBox_Name" Text="{Binding Name, Mode=OneWay}"/>

                <Label Grid.Row="1" Content="{Binding CInfo.Ruby.Value, Source={x:Static yw:Vocab.Current}}"/>
                <ct:Button Grid.Row="1" Style="{StaticResource CopyButton}" Tag="{Binding ElementName=TextBox_Ruby}"/>
                <TextBox Grid.Row="1" x:Name="TextBox_Ruby" Text="{Binding Ruby, Mode=OneWay}"/>

                <Label Grid.Row="2" Content="{Binding CInfo.EnName.Value, Source={x:Static yw:Vocab.Current}}"/>
                <ct:Button Grid.Row="2" Style="{StaticResource CopyButton}" Tag="{Binding ElementName=TextBox_EnName}"/>
                <TextBox Grid.Row="2" x:Name="TextBox_EnName" Text="{Binding EnName, Mode=OneWay}"/>

                <ct:Button Grid.Column="2" Style="{StaticResource IconButtonBase}" Content="{Binding Detach.Value, Source={x:Static yw:Vocab.Current}}" Icon="{x:Static media:Icons.NewWindow}" Background="Transparent" HorizontalAlignment="Right" Command="yw:YgoCommands.DetachCardInfo" CommandParameter="{Binding}" Visibility="{Binding IsEnabled, RelativeSource={RelativeSource Mode=Self}, Converter={StaticResource BVConv}}" Margin="1,3" Padding="3,0"/>
            </Grid>
            <!-- type and limit -->
            <Grid Grid.Row="1" ColumnDefinitions="1*, 5*">
                <Label Content="{Binding CInfo.CardType.Value, Source={x:Static yw:Vocab.Current}}"/>
                <Grid Grid.Column="1" ColumnDefinitions="Auto, *, Auto, Auto">
                    <ct:IconPresenter Grid.Column="0" Source="{Binding Icon}" Margin="4,0,2,0"/>
                    <TextBlock Grid.Column="1" Margin="0" Text="{Binding CardTypeText}"/>
                    <ct:IconPresenter Grid.Column="2" Margin="8,0,2,0" Source="{Binding LimitIcon}"/>
                    <TextBlock Grid.Column="3" Margin="0,0,4,0" Text="{Binding LimitText}"/>
                </Grid>
            </Grid>
            <!-- card text -->
            <Grid Grid.Row="2" Grid.Column="2" ColumnDefinitions="Auto, *, Auto">
                <Label Grid.Column="0" Content="{Binding CInfo.Text.Value, Source={x:Static yw:Vocab.Current}}"/>
                <ct:Button Style="{StaticResource CopyButton}" Tag="{Binding ElementName=TextBox_Text}"/>
                <TextBlock Grid.Column="2" FontSize="13" Margin="0" VerticalAlignment="Bottom">
                    <Run Text="{Binding CInfo.Id.Value, Source={x:Static yw:Vocab.Current}, Mode=OneWay}"/>:<Run Text="{Binding Id}"/>
                    <Hyperlink Focusable="False" Click="OnClick_DB1">
                        <Run Text="{Binding OfficialDatabase.Value, Source={x:Static yw:Vocab.Current}, Mode=OneWay}"/>
                    </Hyperlink>
                    <Hyperlink Focusable="False" Click="OnClick_DB2">
                        <Run Text="{Binding TcgDatabase.Value, Source={x:Static yw:Vocab.Current}, Mode=OneWay}"/>
                    </Hyperlink>
                </TextBlock>
            </Grid>
            <TextBox Grid.Row="3" x:Name="TextBox_Text" Style="{StaticResource TextBox_Text}" Text="{Binding Text, Mode=OneWay, Converter={StaticResource LFConv}}"/>
            <TextBlock Grid.Row="3" Style="{StaticResource TextBlock_TextLength}" Text="{Binding Text, ElementName=TextBox_Text, Converter={StaticResource TextLengthConverter}}"/>

            <!-- pack info -->
            <Grid Grid.Row="3" Grid.RowSpan="2" RowDefinitions="Auto, *" VerticalAlignment="Bottom">
                <Expander x:Name="Expander_PackList" ExpandDirection="Up" Background="White" Padding="0" BorderThickness="0">
                    <Expander.Header>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <StackPanel.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Margin" Value="1,0"/>
                                </Style>
                            </StackPanel.Resources>
                            <TextBlock Text="{Binding CInfo.PackInfo.Value, Source={x:Static yw:Vocab.Current}}" Margin="0,0,1,0"/>
                            <TextBlock Text="("/>
                            <TextBlock Text="{Binding PackInfo.OcgCount}"/>
                            <TextBlock Text="+"/>
                            <TextBlock Text="{Binding PackInfo.TcgCount}"/>
                            <TextBlock Text="="/>
                            <TextBlock Text="{Binding PackInfo.Count}"/>
                            <TextBlock Text=")"/>
                        </StackPanel>
                    </Expander.Header>
                </Expander>
                <ListBox Style="{StaticResource CardInfo_ListBox}" ItemsSource="{Binding PackInfo}" Height="{Binding IsExpanded, ElementName=Expander_PackList, Converter={StaticResource ExpConv}}">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="ygd:PackInfo">
                            <Grid Background="Transparent" ColumnDefinitions="Auto, 4, Auto, 4, *">
                                <TextBlock Grid.Column="0" Text="{Binding DateText}" Margin="0"/>
                                <TextBlock Grid.Column="2" Text="{Binding Number}" FontFamily="Consolas" FontSize="9" VerticalAlignment="Bottom" Margin="0,0,0,1" />
                                <TextBlock Grid.Column="4" x:Name="Link" Margin="0">
                                <Hyperlink Focusable="False" Command="yw:YgoCommands.PackLink" CommandParameter="{Binding ProductId}">
                                    <Run Text="{Binding Name, Mode=OneWay}"/>
                                </Hyperlink>
                                </TextBlock>
                                <Popup x:Name="Popup" IsOpen="False" PlacementTarget="{Binding ElementName=Link}">
                                    <Border Style="{StaticResource HelpPopupContent}">
                                        <TextBlock Text="{Binding Name}"/>
                                    </Border>
                                </Popup>
                            </Grid>
                            <DataTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True" SourceName="Link">
                                    <Setter TargetName="Popup" Property="IsOpen" Value="True"/>
                                </Trigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
