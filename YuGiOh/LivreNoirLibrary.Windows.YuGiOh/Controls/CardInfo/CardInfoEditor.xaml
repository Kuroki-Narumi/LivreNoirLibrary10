<UserControl x:Class="LivreNoirLibrary.Windows.YuGiOh.Controls.CardInfoEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:LivreNoirLibrary.Windows.YuGiOh.Controls"
             xmlns:ygo="clr-namespace:LivreNoirLibrary.Windows.YuGiOh"
             xmlns:ct="clr-namespace:LivreNoirLibrary.Windows.Controls;assembly=LivreNoirLibrary.Windows.Controls"
             xmlns:md="clr-namespace:LivreNoirLibrary.Windows.Media;assembly=LivreNoirLibrary.Windows.Media"
             xmlns:ygd="clr-namespace:LivreNoirLibrary.YuGiOh.Data;assembly=LivreNoirLibrary.YuGiOh.Core"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/LivreNoirLibrary.Windows.YuGiOh;component/Themes/Generic.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="TextBox">
                <Setter Property="Margin" Value="2,2,0,2"/>
                <Setter Property="Padding" Value="2"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Grid.Column" Value="2"/>
            </Style>
            <Style x:Key="TextBox_Text" TargetType="TextBox" BasedOn="{StaticResource TextBox_Scrollable}">
                <Setter Property="Margin" Value="0"/>
            </Style>
            <Style TargetType="Label" BasedOn="{StaticResource Label_Header}"/>
            <Style TargetType="TextBlock">
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="4,0"/>
            </Style>
            <Style x:Key="TextBlock_TextLength" TargetType="TextBlock">
                <Setter Property="Background" Value="{ct:BrushProvider #8fff}"/>
                <Setter Property="VerticalAlignment" Value="Bottom"/>
                <Setter Property="HorizontalAlignment" Value="Right"/>
                <Setter Property="Margin" Value="0,0,1,1"/>
                <Setter Property="Padding" Value="2,0"/>
                <Setter Property="IsHitTestVisible" Value="False"/>
            </Style>
            <Style TargetType="ct:IconPresenter">
                <Setter Property="Height" Value="16"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <Style x:Key="ComboBoxItemContainerStyle" TargetType="ComboBoxItem">
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="VerticalAlignment" Value="Stretch"/>
                <Setter Property="Background" Value="{Binding Background}"/>
                <Setter Property="Grid.Column" Value="{Binding Column}"/>
                <Setter Property="Grid.Row" Value="{Binding Row}"/>
            </Style>
            <Style TargetType="ComboBox" x:Key="ComboBoxBase2" BasedOn="{StaticResource ComboBoxBase}">
                <Setter Property="BorderBrush" Value="Transparent"/>
                <EventSetter Event="PreviewMouseWheel" Handler="OnMouseWheel_ComboBox"/>
            </Style>
            <Style TargetType="ComboBox" x:Key="CardTypeSelector" BasedOn="{StaticResource ComboBoxBase2}">
                <Setter Property="ItemsSource" Value="{x:Static local:CardTypeItem.Items}"/>
                <Setter Property="ItemsPanel">
                    <Setter.Value>
                        <ItemsPanelTemplate>
                            <Grid ColumnDefinitions="Auto, Auto, Auto" RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto"/>
                        </ItemsPanelTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="ItemContainerStyle" Value="{StaticResource ComboBoxItemContainerStyle}"/>
                <Setter Property="ItemTemplate">
                    <Setter.Value>
                        <DataTemplate DataType="local:CardTypeItem">
                            <StackPanel Orientation="Horizontal">
                                <ct:IconPresenter Height="16" Source="{Binding Icon}"/>
                                <TextBlock Padding="2,0,0,0" Text="{Binding Name.Value}"/>
                            </StackPanel>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="ComboBox" x:Key="AttributeSelector" BasedOn="{StaticResource ComboBoxBase2}">
                <Setter Property="ItemsSource" Value="{x:Static local:AttributeItem.Items}"/>
                <Setter Property="ItemsPanel">
                    <Setter.Value>
                        <ItemsPanelTemplate>
                            <Grid ColumnDefinitions="Auto, Auto" RowDefinitions="Auto, Auto, Auto, Auto"/>
                        </ItemsPanelTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="ItemContainerStyle" Value="{StaticResource ComboBoxItemContainerStyle}"/>
                <Setter Property="ItemTemplate">
                    <Setter.Value>
                        <DataTemplate DataType="local:AttributeItem">
                            <StackPanel Orientation="Horizontal">
                                <ct:IconPresenter Height="16" Source="{Binding Icon}"/>
                                <TextBlock Padding="2,0,0,0" Text="{Binding Name.Value}"/>
                            </StackPanel>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="ComboBox" x:Key="MonsterTypeSelector" BasedOn="{StaticResource ComboBoxBase2}">
                <Setter Property="ItemsSource" Value="{x:Static local:MonsterTypeItem.Items}"/>
                <Setter Property="ItemsPanel">
                    <Setter.Value>
                        <ItemsPanelTemplate>
                            <Grid ColumnDefinitions="Auto, Auto, Auto" RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto"/>
                        </ItemsPanelTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="ItemContainerStyle" Value="{StaticResource ComboBoxItemContainerStyle}"/>
                <Setter Property="ItemTemplate">
                    <Setter.Value>
                        <DataTemplate DataType="local:MonsterTypeItem">
                            <TextBlock Text="{Binding Name.Value}"/>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="ct:LabeledSlider" x:Key="Slider_Base">
                <Setter Property="IsTextEditable" Value="True"/>
                <Setter Property="IsSnapToTickEnabled" Value="True"/>
                <Setter Property="Margin" Value="2,0,4,0"/>
                <Setter Property="Grid.Column" Value="1"/>
            </Style>
            <Style TargetType="ct:LabeledSlider" x:Key="Slider_Level" BasedOn="{StaticResource Slider_Base}">
                <Setter Property="Minimum" Value="0"/>
                <Setter Property="Maximum" Value="13"/>
                <Setter Property="SmallChange" Value="1"/>
                <Setter Property="LargeChange" Value="1"/>
                <Setter Property="TickFrequency" Value="1"/>
                <Setter Property="TextWidth" Value="28"/>
            </Style>
            <Style TargetType="ct:LabeledSlider" x:Key="Slider_Status" BasedOn="{StaticResource Slider_Base}">
                <Setter Property="Minimum" Value="-1"/>
                <Setter Property="Maximum" Value="5000"/>
                <Setter Property="SmallChange" Value="10"/>
                <Setter Property="LargeChange" Value="50"/>
                <Setter Property="TickFrequency" Value="10"/>
                <Setter Property="Ticks" Value="{x:Static local:CardInfoEditor.StatusTicks}"/>
                <Setter Property="TextWidth" Value="45"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid RowDefinitions="Auto, Auto, *" x:Name="MainGrid" d:DataContext="{d:DesignInstance Type=local:CardInfoViewModel}">
        <Grid Grid.Row="0" ColumnDefinitions="Auto, Auto, *" RowDefinitions="Auto, Auto, Auto">
            <Label Grid.Row="0" Content="{Binding CInfo.Name.Value, Source={x:Static ygo:Vocab.Current}}"/>
            <TextBox Grid.Row="0" x:Name="TextBox_Name" Text="{Binding Card.Name, Mode=TwoWay}"/>
            <Label Grid.Row="1" Content="{Binding CInfo.Ruby.Value, Source={x:Static ygo:Vocab.Current}}"/>
            <TextBox Grid.Row="1" x:Name="TextBox_Ruby" Text="{Binding Card.Ruby, Mode=TwoWay}"/>
            <Label Grid.Row="2" Content="{Binding CInfo.EnName.Value, Source={x:Static ygo:Vocab.Current}}"/>
            <TextBox Grid.Row="2" x:Name="TextBox_EnName" Text="{Binding Card.EnName, Mode=TwoWay}"/>
        </Grid>
        <Grid Grid.Row="1" ColumnDefinitions="1*, 5*, 8, 6*">
            <Label Content="{Binding CInfo.CardType.Value, Source={x:Static ygo:Vocab.Current}}"/>
            <ComboBox Grid.Column="1" Style="{StaticResource CardTypeSelector}" SelectedItem="{Binding CardType, Mode=TwoWay, Converter={StaticResource CIConv}}"/>
            <Label Grid.Column="3" HorizontalAlignment="Left" Content="{Binding CInfo.Text.Value, Source={x:Static ygo:Vocab.Current}}"/>
        </Grid>
        <Grid Grid.Row="2" ColumnDefinitions="*, 8, *">
            <TextBox Grid.Column="2" x:Name="TextBox_Text" Style="{StaticResource TextBox_Text}" Text="{Binding Card.Text, Mode=TwoWay, Converter={StaticResource LFConv}}"/>
            <TextBlock Grid.Column="2" Style="{StaticResource TextBlock_TextLength}" Text="{Binding Text, ElementName=TextBox_Text, Converter={StaticResource TextLengthConverter}}"/>
            <Grid RowDefinitions="Auto, *">
                <Grid RowDefinitions="Auto, Auto, Auto" Visibility="{Binding HasMonsterInfo, Converter={StaticResource BVConv}}">
                    <Grid Grid.Row="0" ColumnDefinitions="*, 2*, *, 2*">
                        <Label Grid.Column="0" Content="{Binding CInfo.Attribute.Value, Source={x:Static ygo:Vocab.Current}}"/>
                        <ComboBox Grid.Column="1" Style="{StaticResource AttributeSelector}" SelectedItem="{Binding Card.Attribute, Mode=TwoWay, Converter={StaticResource CIConv}}"/>
                        <Label Grid.Column="2" Content="{Binding CInfo.MonsterType.Value, Source={x:Static ygo:Vocab.Current}}"/>
                        <ComboBox Grid.Column="3" Style="{StaticResource MonsterTypeSelector}" SelectedItem="{Binding Card.MonsterType, Mode=TwoWay, Converter={StaticResource CIConv}}"/>
                    </Grid>
                    <Grid Grid.Row="1" ColumnDefinitions="*, 5*">
                        <Label Style="{StaticResource Label_Header}" Grid.Column="0" Content="能力"/>
                        <Grid Grid.Column="1" RowDefinitions="Auto, Auto, Auto">
                            <Grid.Resources>
                                <Style TargetType="ct:ToggleButton">
                                    <Setter Property="BorderBrush" Value="{x:Null}"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="Padding" Value="4,0"/>
                                    <Setter Property="CornerRadius" Value="0"/>
                                    <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnMouseLeftButtonDown_ToggleButton"/>
                                    <EventSetter Event="MouseEnter" Handler="OnMouseEnter_ToggleButton"/>
                                </Style>
                            </Grid.Resources>
                            <Grid Grid.Row="0" ColumnDefinitions="4*, 6*, 5*">
                                <ct:ToggleButton Grid.Column="0" Content="{Binding CType.Effect.Value, Source={x:Static ygo:Vocab.Current}}" IsChecked="{Binding Card.HasEffect}"/>
                                <ct:ToggleButton Grid.Column="1" Content="{Binding Abi.Pendulum, Source={x:Static ygo:Vocab.Current}}" IsChecked="{Binding IsPendulum}"/>
                                <ct:ToggleButton Grid.Column="2" Content="{Binding Abi.SpecialSummon, Source={x:Static ygo:Vocab.Current}}" IsChecked="{Binding IsSpecialSummon}" IsEnabled="{Binding IsSpecialSummonEnabled}"/>
                            </Grid>
                            <Grid Grid.Row="1" ColumnDefinitions="*, *, *">
                                <ct:ToggleButton Grid.Column="0" Content="{Binding Abi.Tuner.Value, Source={x:Static ygo:Vocab.Current}}" IsChecked="{Binding IsTuner}" IsEnabled="{Binding IsTunerEnabled}"/>
                                <ct:ToggleButton Grid.Column="1" Content="{Binding Abi.Flip.Value, Source={x:Static ygo:Vocab.Current}}" IsChecked="{Binding IsFlip}" IsEnabled="{Binding IsLevelEnabled}"/>
                                <ct:ToggleButton Grid.Column="2" Content="{Binding Abi.Spirit.Value, Source={x:Static ygo:Vocab.Current}}" IsChecked="{Binding IsSpirit}"/>
                            </Grid>
                            <Grid Grid.Row="2" ColumnDefinitions="*, *, *">
                                <ct:ToggleButton Grid.Column="0" Content="{Binding Abi.Toon.Value, Source={x:Static ygo:Vocab.Current}}" IsChecked="{Binding IsToon}"/>
                                <ct:ToggleButton Grid.Column="1" Content="{Binding Abi.Gemini.Value, Source={x:Static ygo:Vocab.Current}}" IsChecked="{Binding IsGemini}"/>
                                <ct:ToggleButton Grid.Column="2" Content="{Binding Abi.Union.Value, Source={x:Static ygo:Vocab.Current}}" IsChecked="{Binding IsUnion}"/>
                            </Grid>
                        </Grid>
                    </Grid>
                    <Grid Grid.Row="2" RowDefinitions="Auto, Auto" ColumnDefinitions="*, 2*, 3*">
                        <Label Grid.Row="0" Content="{Binding LevelName.Value}"/>
                        <ct:LabeledSlider Grid.Row="0" Style="{StaticResource Slider_Level}" Value="{Binding Card.Level, Mode=TwoWay}" IsEnabled="{Binding IsLevelEnabled}"/>
                        <Label Grid.Row="1" Content="{Binding CInfo.Atk.Value, Source={x:Static ygo:Vocab.Current}}"/>
                        <ct:LabeledSlider Grid.Row="1" Style="{StaticResource Slider_Status}" Value="{Binding Card.Atk, Mode=TwoWay}"/>
                        <Grid Grid.Row="1" Grid.Column="2" ColumnDefinitions="*, 2*" Visibility="{Binding IsLevelEnabled, Converter={StaticResource TVConv}}">
                            <Label Content="{Binding CInfo.Def.Value, Source={x:Static ygo:Vocab.Current}}"/>
                            <ct:LabeledSlider Grid.Row="1" Style="{StaticResource Slider_Status}" Value="{Binding Card.Def, Mode=TwoWay}"/>
                        </Grid>
                        <Grid Grid.RowSpan="2" Grid.Column="2" ColumnDefinitions="*, *" Visibility="{Binding IsLevelEnabled, Converter={StaticResource TVConvI}}">
                            <Label Content="{Binding CInfo.LinkMarker.Value, Source={x:Static ygo:Vocab.Current}}"/>
                            <local:LinkMarkerView Grid.Column="1" Width="{Binding ActualHeight, RelativeSource={RelativeSource Self}}" Direction="{Binding LinkDirections, Mode=TwoWay}"/>
                        </Grid>
                    </Grid>
                </Grid>
                <Grid Grid.Row="1" RowDefinitions="Auto, *" Visibility="{Binding HasPendulumInfo, Converter={StaticResource BVConv}}">
                    <Grid ColumnDefinitions="*, *, 2*, 2*">
                        <Label Content="{Binding CInfo.PendulumText.Value, Source={x:Static ygo:Vocab.Current}}"/>
                        <Label Grid.Column="2" Content="{Binding CInfo.PendulumScale.Value, Source={x:Static ygo:Vocab.Current}}"/>
                        <ct:LabeledSlider Grid.Column="3" Style="{StaticResource Slider_Level}" Value="{Binding Card.PendulumScale, Mode=TwoWay}"/>
                    </Grid>
                    <TextBox Grid.Row="1" x:Name="TextBox_PText" Style="{StaticResource TextBox_Text}" Text="{Binding Card.PendulumText, Mode=TwoWay, Converter={StaticResource LFConv}}"/>
                    <TextBlock Grid.Row="1" Style="{StaticResource TextBlock_TextLength}" Text="{Binding Text, ElementName=TextBox_PText, Converter={StaticResource TextLengthConverter}}"/>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
