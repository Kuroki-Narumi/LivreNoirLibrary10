<Window x:Class="LivreNoirLibrary.Windows.YuGiOh.Controls.CardInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LivreNoirLibrary.Windows.YuGiOh.Controls"
        xmlns:ygo="clr-namespace:LivreNoirLibrary.Windows.YuGiOh"
        mc:Ignorable="d"
        FontSize="14" FontFamily="Meiryo" UseLayoutRounding="True"
        Height="600" Width="740"
        local:YgoEvents.RequestOpenCardUrl="OnRequestOpenCardUrl"
        SnapsToDevicePixels="True" ShowInTaskbar="False" ResizeMode="NoResize">
    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="{Binding Close.Value, Source={x:Static ygo:Vocab.Current}}" Click="OnClick_Close"/>
        </ContextMenu>
    </Window.ContextMenu>
    <local:CardInfoView x:Name="InfoView" Margin="4"/>
</Window>
