<local:SaveImageBase x:Class="LivreNoirLibrary.Windows.YuGiOh.Controls.DeckRecipeControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:LivreNoirLibrary.Windows.YuGiOh.Controls"
             xmlns:ct="clr-namespace:LivreNoirLibrary.Windows.Controls;assembly=LivreNoirLibrary.Windows.Controls"
             xmlns:media="clr-namespace:LivreNoirLibrary.Windows.Media;assembly=LivreNoirLibrary.Windows.Media"
             xmlns:yw="clr-namespace:LivreNoirLibrary.Windows.YuGiOh;assembly=LivreNoirLibrary.Windows.YuGiOh"
             xmlns:ygo="clr-namespace:LivreNoirLibrary.YuGiOh.Data;assembly=LivreNoirLibrary.YuGiOh.Core"
             xmlns:yg="clr-namespace:LivreNoirLibrary.YuGiOh;assembly=LivreNoirLibrary.YuGiOh.Core"
             xmlns:input="clr-namespace:LivreNoirLibrary.Windows.Input;assembly=LivreNoirLibrary.Windows.Core"
             mc:Ignorable="d" Background="White"
             >
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/LivreNoirLibrary.Windows.YuGiOh;component/Themes/Generic.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="ct:Button">
                <Setter Property="Margin" Value="4,0,4,0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style TargetType="ct:ToggleButton">
                <Setter Property="Margin" Value="4,0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style TargetType="ct:LabeledSlider" x:Key="SliderBase">
                <Setter Property="Margin" Value="4,0"/>
                <Setter Property="SliderWidth" Value="70"/>
                <Setter Property="TickFrequency" Value="5"/>
                <Setter Property="IsSnapToTickEnabled" Value="True"/>
                <Setter Property="IsTextEditable" Value="True"/>
                <Setter Property="TextWidth" Value="36"/>
            </Style>
            <Style TargetType="ct:LabeledSlider" BasedOn="{StaticResource SliderBase}">
                <Setter Property="Minimum" Value="90"/>
                <Setter Property="Maximum" Value="250"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid x:Name="MainGrid" RowDefinitions="Auto, 4, Auto, 4, *" d:DataContext="{d:DesignInstance Type=local:DeckRecipeControl}">
        <StackPanel Orientation="Horizontal">
            <TextBlock Margin="4,0">
                <Run Text="{Binding ActualWidth, Mode=OneWay, ElementName=DeckRecipeView, StringFormat={}{0:0}}"/> x <Run Text="{Binding ActualHeight, Mode=OneWay, ElementName=DeckRecipeView, StringFormat={}{0:0}}"/>
            </TextBlock>
            <ct:Button Icon="{x:Static media:Icons.Picture}" Content="{Binding SaveAsImage, Source={x:Static yw:Vocab.Current}}" Click="OnClick_SaveAsImage"/>
            <TextBlock Margin="4,0,0,0" Text="{Binding Deck_Order, Source={x:Static yw:Vocab.Current}}"/>
            <ComboBox ItemsSource="{x:Static local:DeckRecipeOrderItem.Items}" SelectedItem="{Binding Order}" Margin="4,0">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name.Value}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Text="{Binding Deck_Separator, Source={x:Static yw:Vocab.Current}}"/>
            <ComboBox ItemsSource="{x:Static local:DeckRecipeSeparatorItem.Items}" SelectedItem="{Binding Separator}" Margin="4,0">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <ct:ToggleButton Content="{Binding Deck_WithBracket, Source={x:Static yw:Vocab.Current}}" IsChecked="{Binding WithBracket}"/>
            <ct:Button Icon="{x:Static media:Icons.Copy}" Content="{Binding CopyImage, Source={x:Static yw:Vocab.Current}}" Click="OnClick_CopyImage"/>
        </StackPanel>
        <WrapPanel Grid.Row="2" Orientation="Horizontal">
            <ct:LabeledSlider Style="{StaticResource SliderBase}" Minimum="8" Maximum="36" TickFrequency="1"
                              Header="{Binding CInfo.Name.Value, Source={x:Static yw:Vocab.Current}}" Value="{Binding FontSize, ElementName=DeckRecipeView}"/>
            <ct:LabeledSlider Style="{StaticResource SliderBase}" Minimum="16" Maximum="64" TickFrequency="1"
                              Header="{Binding Deck_ContentHeight.Value, Source={x:Static yw:Vocab.Current}}" Value="{Binding ContentHeight, ElementName=DeckRecipeView}"/>
            <TextBlock Text="{Binding Deck_NameWidth.Value, Source={x:Static yw:Vocab.Current}}" Margin="4,0"/>
            <ct:LabeledSlider Header="Main1" Value="{Binding NameWidth1, ElementName=DeckRecipeView, Converter={StaticResource SGLConv}}"/>
            <ct:LabeledSlider Header="Main2" Value="{Binding NameWidth2, ElementName=DeckRecipeView, Converter={StaticResource SGLConv}}"/>
            <ct:LabeledSlider Header="EX" Value="{Binding NameWidth3, ElementName=DeckRecipeView, Converter={StaticResource SGLConv}}"/>
            <ct:LabeledSlider Header="Side" Value="{Binding NameWidth4, ElementName=DeckRecipeView, Converter={StaticResource SGLConv}}"/>
        </WrapPanel>
        <ScrollViewer Grid.Row="4" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <local:DeckRecipeView x:Name="DeckRecipeView" Deck="{Binding Deck}" LineBreaks="{Binding LineBreaks}"/>
        </ScrollViewer>
    </Grid>
</local:SaveImageBase>
