    <Style x:Key="LargeButtonBase" TargetType="ct:Button">
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
    </Style>

    <Style x:Key="LargeButton_Blue" TargetType="ct:Button" BasedOn="{StaticResource LargeButtonBase}">
        <Setter Property="Background" Value="{ct:BrushProvider #f8f8ff}"/>
    </Style>

    <Style x:Key="LargeButton_Green" TargetType="ct:Button" BasedOn="{StaticResource LargeButtonBase}">
        <Setter Property="Background" Value="{ct:BrushProvider #f8fff8}"/>
        <Setter Property="Grid.Row" Value="1"/>
    </Style>

    <Style x:Key="LargeButton_Red" TargetType="ct:Button" BasedOn="{StaticResource LargeButtonBase}">
        <Setter Property="Background" Value="{ct:BrushProvider #fff8f8}"/>
        <Setter Property="Grid.Row" Value="2"/>
    </Style>

    <Style x:Key="LargeButtonStackPanel" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Vertical"/>
    </Style>

    <Style x:Key="LargeButtonIcon" TargetType="ct:IconPresenter">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Height" Value="16"/>
    </Style>
    
    <Style x:Key="SearchWindow_Header" TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="4,0"/>
    </Style>

    <Style x:Key="SearchWindow_ToggleButton" TargetType="ct:ToggleButton">
        <Setter Property="IconPadding" Value="2"/>
        <Setter Property="Padding" Value="4"/>
        <Setter Property="Margin" Value="4"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
    </Style>

    <Style x:Key="SearchWindow_CheckBox" TargetType="CheckBox">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
    </Style>

    <Style x:Key="SearchWindow_RadioButton" TargetType="RadioButton">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
    </Style>

    <Style x:Key="RadioContainerBase" TargetType="Panel">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="ToolTipBorder" TargetType="Border" BasedOn="{StaticResource HelpPopupContent}">
        <Setter Property="Control.FontFamily" Value="Yu Gothic UI"/>
    </Style>
    <Style x:Key="ToolTipText" TargetType="TextBlock">
        <Setter Property="MaxWidth" Value="340"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Text" Value="{Binding ThisCard.FullText}"/>
    </Style>
    
    <DataTemplate x:Key="ItemTemplate_Name" DataType="data:ICard">
        <StackPanel Orientation="Horizontal">
            <ct:IconPresenter Height="16" Source="{Binding ThisCard.Icon}" Margin="0,0,2,0"/>
            <TextBlock Text="{Binding ThisCard.Name}"/>
            <Popup x:Name="Popup" IsOpen="False">
                <Border Style="{StaticResource ToolTipBorder}">
                    <TextBlock Text="{Binding ThisCard.Name}"/>
                </Border>
            </Popup>
        </StackPanel>
        <DataTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Popup" Property="IsOpen" Value="True"/>
            </Trigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="ItemTemplate_NameWithLink" DataType="data:ICard">
        <StackPanel Orientation="Horizontal">
            <ct:IconPresenter Height="16" Source="{Binding ThisCard.Icon}" Margin="0,0,2,0"/>
            <TextBlock>
                <Hyperlink Focusable="False" Command="ygo:YgoCommands.DetachCardInfo" CommandParameter="{Binding ThisCard}">
                    <Run Text="{Binding ThisCard.Name}"/>
                </Hyperlink>
            </TextBlock>
            <Popup x:Name="Popup" IsOpen="False">
                <Border Style="{StaticResource ToolTipBorder}">
                    <TextBlock Text="{Binding ThisCard.Name}"/>
                </Border>
            </Popup>
        </StackPanel>
        <DataTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Popup" Property="IsOpen" Value="True"/>
            </Trigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="ItemTemplate_NameWithLimit" DataType="data:ICard">
        <StackPanel Orientation="Horizontal">
            <ct:IconPresenter Height="16" Source="{Binding ThisCard.Icon}" Margin="0,0,2,0"/>
            <ct:IconPresenter Height="16" Source="{Binding ThisCard.LimitIcon}"/>
            <TextBlock Text="{Binding ThisCard.Name}"/>
            <Popup x:Name="Popup" IsOpen="False">
                <Border Style="{StaticResource ToolTipBorder}">
                    <TextBlock Text="{Binding ThisCard.Name}"/>
                </Border>
            </Popup>
        </StackPanel>
        <DataTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Popup" Property="IsOpen" Value="True"/>
            </Trigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="ItemTemplate_FullText" DataType="data:ICard">
        <StackPanel Orientation="Horizontal" Background="Transparent">
            <ct:IconPresenter Height="16" Source="{Binding ThisCard.Icon}" Margin="0,0,2,0"/>
            <TextBlock Text="{Binding ThisCard.Name}"/>
            <StackPanel.ToolTip>
                <StackPanel>
                    <TextBlock Text="{Binding ThisCard.Name}"/>
                    <TextBlock Style="{StaticResource ToolTipText}"/>
                </StackPanel>
            </StackPanel.ToolTip>
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="ItemTemplate_FullTextWithLink" DataType="data:ICard">
        <StackPanel Orientation="Horizontal">
            <ct:IconPresenter Height="16" Source="{Binding ThisCard.Icon}" Margin="0,0,2,0"/>
            <TextBlock>
                <Hyperlink Focusable="False" Command="ygo:YgoCommands.DetachCardInfo" CommandParameter="{Binding ThisCard}">
                    <Run Text="{Binding ThisCard.Name}"/>
                </Hyperlink>
            </TextBlock>
            <StackPanel.ToolTip>
                <StackPanel>
                    <TextBlock Text="{Binding ThisCard.Name}"/>
                    <TextBlock Style="{StaticResource ToolTipText}"/>
                </StackPanel>
            </StackPanel.ToolTip>
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="ItemTemplate_FullTextWithLimit" DataType="data:ICard">
        <StackPanel Orientation="Horizontal" Background="Transparent">
            <ct:IconPresenter Height="16" Source="{Binding ThisCard.Icon}" Margin="0,0,2,0"/>
            <ct:IconPresenter Height="16" Source="{Binding ThisCard.LimitIcon}"/>
            <TextBlock Text="{Binding ThisCard.Name}"/>
            <StackPanel.ToolTip>
                <StackPanel>
                    <TextBlock Text="{Binding ThisCard.Name}"/>
                    <TextBlock Style="{StaticResource ToolTipText}"/>
                </StackPanel>
            </StackPanel.ToolTip>
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="ItemTemplate_CheckableFullText" DataType="data:CheckableCard">
        <StackPanel x:Name="panel" Orientation="Horizontal" HorizontalAlignment="Stretch">
            <CheckBox IsChecked="{Binding IsChecked, Mode=OneWay}" Focusable="False" IsHitTestVisible="False" Margin="0,0,2,0" VerticalContentAlignment="Center"/>
            <ct:IconPresenter Height="16" Source="{Binding ThisCard.Icon}" Margin="0,0,2,0"/>
            <TextBlock Text="{Binding ThisCard.Name}"/>
            <StackPanel.ToolTip>
                <StackPanel>
                    <TextBlock Text="{Binding ThisCard.Name}"/>
                    <TextBlock Style="{StaticResource ToolTipText}"/>
                </StackPanel>
            </StackPanel.ToolTip>
        </StackPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsChecked}" Value="True">
                <Setter TargetName="panel" Property="Background" Value="{StaticResource Brush_Background_Checked}"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="GridViewHeader_Name">
        <TextBlock Text="{Binding CInfo.Name.Value, Source={x:Static ygo:Vocab.Current}}" Tag="Name"/>
    </DataTemplate>
    <DataTemplate x:Key="GridViewHeader_CardType">
