    </Style>
    <Style x:Key="MenuItem_Redo" TargetType="MenuItem" BasedOn="{StaticResource MenuItemBase_Redo}">
        <Setter Property="Header" Value="{Binding Redo.MenuHeader, Source={x:Static ygo:Vocab.Current}}"/>
    </Style>
    <Style x:Key="MenuItem_AllClear" TargetType="MenuItem" BasedOn="{StaticResource MenuItemBase_New}">
        <Setter Property="Header" Value="{Binding AllClear.MenuHeader, Source={x:Static ygo:Vocab.Current}}"/>
    </Style>
    <Style x:Key="MenuItem_New" TargetType="MenuItem" BasedOn="{StaticResource MenuItemBase_New}">
