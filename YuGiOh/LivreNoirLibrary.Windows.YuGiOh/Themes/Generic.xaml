    <Style x:Key="MenuItem_Cut" TargetType="MenuItem" BasedOn="{StaticResource MenuItemBase_Cut}">
        <Setter Property="Header" Value="{Binding Cut.MenuHeader, Source={x:Static ygo:Vocab.Current}}"/>
    </Style>
    <Style x:Key="MenuItem_Copy" TargetType="MenuItem" BasedOn="{StaticResource MenuItemBase_Copy}">
        <Setter Property="Header" Value="{Binding Copy.MenuHeader, Source={x:Static ygo:Vocab.Current}}"/>
