    </DataTemplate>
    <DataTemplate x:Key="ItemTemplate_Detail" DataType="data:ICard">
        <Grid HorizontalAlignment="Center">
            <TextBlock Background="{ct:BrushProvider #eee}" Text=" ... "/>
            <Popup x:Name="Popup" IsOpen="False">
                <Border Style="{StaticResource ToolTipBorder}">
                    <TextBlock Style="{StaticResource ToolTipText}"/>
                </Border>
            </Popup>
        </Grid>
        <DataTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="true">
                <Setter TargetName="Popup" Property="IsOpen" Value="True"/>
            </Trigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <Style TargetType="ListBox" x:Key="CardListView" BasedOn="{StaticResource Alt2ListBoxStyle}">
        <Setter Property="SelectionMode" Value="Single"/>
        <Setter Property="ItemTemplate" Value="{StaticResource ItemTemplate_FullText}"/>
    </Style>

    <Style TargetType="ListBox" x:Key="CardListView_MultiSelect" BasedOn="{StaticResource Alt2ListBoxStyle}">
        <Setter Property="SelectionMode" Value="Extended"/>
        <Setter Property="ItemTemplate" Value="{StaticResource ItemTemplate_FullText}"/>
    </Style>

    <Style x:Key="EditBarPanel" TargetType="Panel">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Height" Value="27"/>
    </Style>

    <Style x:Key="EditBarStackPanel" TargetType="StackPanel" BasedOn="{StaticResource EditBarPanel}">
        <Setter Property="Orientation" Value="Horizontal"/>
    </Style>

    <Style TargetType="ct:SearchBar">
        <Setter Property="OpenSortText" Value="{Binding Sort.Value, Source={x:Static ygo:Vocab.Current}}"/>
        <Setter Property="OpenSearchText" Value="{Binding Search.Value, Source={x:Static ygo:Vocab.Current}}"/>
        <Setter Property="ClearText" Value="{Binding Clear.Value, Source={x:Static ygo:Vocab.Current}}"/>
    </Style>

    <Style x:Key="Button_PresetApply" TargetType="ct:Button" BasedOn="{StaticResource IconButtonBase}">
        <Setter Property="Icon" Value="{x:Static md:Icons.Check}"/>
        <Setter Property="ToolTip" Value="{Binding Apply.Value, Source={x:Static ygo:Vocab.Current}}"/>
        <Setter Property="Command" Value="local:PresetPresenterBase.ApplyCommand"/>
    </Style>
    <Style x:Key="TextBox_PresetName" TargetType="TextBox">
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Text" Value="{Binding Name, Mode=TwoWay}"/>
        <Setter Property="Grid.Column" Value="1"/>
    </Style>
    <Style x:Key="RadioButton_PresetDefault" TargetType="ct:RadioButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Margin" Value="2,0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="GroupName" Value="DefaultPreset"/>
        <Setter Property="IsOptionMarkVisible" Value="False"/>
        <Setter Property="Icon" Value="{x:Static md:Icons.Download}"/>
        <Setter Property="ToolTip" Value="{Binding SetToDefault.Value, Source={x:Static ygo:Vocab.Current}}"/>
        <Setter Property="IsChecked" Value="{Binding IsDefault, Mode=TwoWay}"/>
        <Setter Property="Command" Value="local:PresetPresenterBase.SetToDefaultCommand"/>
        <Setter Property="Grid.Column" Value="2"/>
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Icon" Value="{x:Static md:Icons.Upload}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="local:PresetPresenterBase">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:PresetPresenterBase">
                    <Grid ColumnDefinitions="Auto, *, Auto">
                        <ct:Button x:Name="PART_Apply" Style="{StaticResource Button_PresetApply}"/>
                        <TextBox x:Name="PART_Name" Style="{StaticResource TextBox_PresetName}"/>
                        <ct:RadioButton x:Name="PART_Default" Style="{StaticResource RadioButton_PresetDefault}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="local:SortOptionView">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:SortOptionView">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid>
                            <Grid.Resources>
                                <Style TargetType="ct:RadioButton">
                                    <Setter Property="Margin" Value="0,0,4,0"/>
                                    <Setter Property="IsOptionMarkVisible" Value="False"/>
                                </Style>
                            </Grid.Resources>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Label x:Name="header" Grid.Column="0" VerticalContentAlignment="Center" Margin="0,0,4,0" Padding="0" Content="{TemplateBinding Header}"/>
                            <ComboBox x:Name="ComboBox" Grid.Column="1" Style="{StaticResource ComboBoxBase}" Margin="0,0,4,0" ItemsSource="{x:Static local:SortSelectionItem.Items}" SelectedItem="{Binding SourceItem, Mode=TwoWay, RelativeSource={RelativeSource Mode=TemplatedParent}}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Margin="0" Text="{Binding VocabData.Value}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <ct:RadioButton Grid.Column="2" Icon="{x:Static md:Icons.ArrowUp}" ToolTip="{Binding Ascending, Source={x:Static ygo:Vocab.Current}}" IsChecked="{Binding IsAscending, Mode=TwoWay, RelativeSource={RelativeSource Mode=TemplatedParent}}"/>
                            <ct:RadioButton Grid.Column="3" Icon="{x:Static md:Icons.ArrowDown}" ToolTip="{Binding Descending, Source={x:Static ygo:Vocab.Current}}" IsChecked="{Binding IsDescending, Mode=TwoWay, RelativeSource={RelativeSource Mode=TemplatedParent}}"/>
                            <ct:Button Grid.Column="4" Margin="0" Icon="{x:Static md:Icons.Delete}" ToolTip="{Binding Clear, Source={x:Static ygo:Vocab.Current}}" Command="input:Commands.TextSearchClear"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Header" Value="{x:Null}">
                            <Setter TargetName="header" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="local:DeckRecipeView">
        <Setter Property="Background" Value="White"/>
        <Setter Property="HeaderHeight" Value="24"/>
        <Setter Property="ContentHeight" Value="36"/>
        <Setter Property="NameWidth1" Value="185"/>
        <Setter Property="NameWidth2" Value="185"/>
        <Setter Property="NameWidth3" Value="185"/>
        <Setter Property="NameWidth4" Value="185"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="UseLayoutRounding" Value="False"/>
        <Setter Property="NumberFontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:DeckRecipeView">
                    <Grid ColumnDefinitions="Auto, Auto, Auto, Auto">
                        <Grid.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="Margin" Value="2,0"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                            </Style>
                            <Style TargetType="TextBox">
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="AcceptsReturn" Value="True"/>
                                <Setter Property="ToolTip" Value="{Binding Deck_LineBreak, Source={x:Static ygo:Vocab.Current}}"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{Binding SelectedBackground, RelativeSource={RelativeSource AncestorType=local:DeckRecipeView}}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                            <Style TargetType="ct:VerticalTextBlock">
                                <Setter Property="CharMargin" Value="2,-2"/>
                            </Style>
                        </Grid.Resources>
                        <Grid Grid.Column="0" Grid.IsSharedSizeScope="True">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="1"/>
                                <RowDefinition Height="{TemplateBinding HeaderHeight}"/>
                                <RowDefinition Height="1"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="1"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Label"/>
                                <ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="{TemplateBinding NameWidth1}"/>
                                <ColumnDefinition Width="1"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel x:Name="MainDeck1" Grid.Row="3" Grid.Column="3" Grid.ColumnSpan="3"/>
                            <!-- header -->
                            <Border Grid.Column="1" Grid.Row="3" Background="{TemplateBinding Background}">
                                <ct:VerticalTextBlock Text="{Binding Deck_Main.Value, Source={x:Static ygo:Vocab.Current}}"/>
                            </Border>
                            <Border Grid.Column="3" Grid.Row="1" Background="{TemplateBinding Background}">
                                <TextBlock Text="{Binding Deck_Count.Value, Source={x:Static ygo:Vocab.Current}}"/>
                            </Border>
                            <Border Grid.Column="5" Grid.Row="1" Background="{TemplateBinding Background}">
                                <TextBlock Text="{Binding CInfo.Name.Value, Source={x:Static ygo:Vocab.Current}}"/>
                            </Border>
                            <!-- vertical border -->
                            <Border Grid.Row="2" Grid.RowSpan="3" Background="{TemplateBinding MainBorderBrush}"/>
                            <Border Grid.Column="2" Grid.RowSpan="5" Background="{TemplateBinding MainBorderBrush}"/>
                            <Border Grid.Column="4" Grid.RowSpan="5" Background="{TemplateBinding VerticalDashBrush}"/>
                            <Border Grid.Column="6" Grid.RowSpan="5" Background="{TemplateBinding MainBorderBrush}"/>
                            <!-- horizontal border -->
                            <Border Grid.Column="2" Grid.ColumnSpan="5" Background="{TemplateBinding MainBorderBrush}"/>
                            <Border Grid.ColumnSpan="7" Grid.Row="2" Background="{TemplateBinding MainBorderBrush}"/>
                            <Border Grid.ColumnSpan="7" Grid.Row="4" Background="{TemplateBinding MainBorderBrush}"/>
                        </Grid>
                        <Grid Grid.Column="1" Grid.IsSharedSizeScope="True">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="1"/>
                                <RowDefinition Height="{TemplateBinding HeaderHeight}"/>
                                <RowDefinition Height="1"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="1"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Label"/>
                                <ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="{TemplateBinding NameWidth2}"/>
                                <ColumnDefinition Width="1"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel x:Name="MainDeck2" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3"/>
                            <!-- header -->
                            <Border Grid.Column="0" Grid.Row="1" Background="{TemplateBinding Background}">
                                <TextBlock Text="{Binding Deck_Count.Value, Source={x:Static ygo:Vocab.Current}}"/>
                            </Border>
                            <Border Grid.Column="2" Grid.Row="1" Background="{TemplateBinding Background}">
                                <TextBlock Text="{Binding CInfo.Name.Value, Source={x:Static ygo:Vocab.Current}}"/>
                            </Border>
                            <!-- vertical border -->
                            <Border Grid.Column="1" Grid.RowSpan="5" Background="{TemplateBinding VerticalDashBrush}"/>
                            <Border Grid.Column="3" Grid.RowSpan="5" Background="{TemplateBinding MainBorderBrush}"/>
                            <!-- horizontal border -->
                            <Border Grid.ColumnSpan="4" Grid.Row="0" Background="{TemplateBinding MainBorderBrush}"/>
                            <Border Grid.ColumnSpan="4" Grid.Row="2" Background="{TemplateBinding MainBorderBrush}"/>
                            <Border Grid.ColumnSpan="4" Grid.Row="4" Background="{TemplateBinding MainBorderBrush}"/>
                        </Grid>
                        <Grid Grid.Column="2" Margin="-1,0,0,0" Visibility="{TemplateBinding IsExtraDeckVisible, Converter={StaticResource BVConv}}" Grid.IsSharedSizeScope="True">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="1"/>
                                <RowDefinition Height="{TemplateBinding HeaderHeight}"/>
                                <RowDefinition Height="1"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="1"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Label"/>
                                <ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="{TemplateBinding NameWidth3}"/>
                                <ColumnDefinition Width="1"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel x:Name="ExtraDeck" Grid.Row="3" Grid.Column="3" Grid.ColumnSpan="3"/>
                            <!-- header -->
                            <Border Grid.Column="1" Grid.Row="3" Background="{TemplateBinding Background}">
                                <ct:VerticalTextBlock Text="{Binding Deck_Extra.Value, Source={x:Static ygo:Vocab.Current}}"/>
                            </Border>
                            <Border Grid.Column="3" Grid.Row="1" Background="{TemplateBinding Background}">
                                <TextBlock Text="{Binding Deck_Count.Value, Source={x:Static ygo:Vocab.Current}}"/>
                            </Border>
                            <Border Grid.Column="5" Grid.Row="1" Background="{TemplateBinding Background}">
                                <TextBlock Text="{Binding CInfo.Name.Value, Source={x:Static ygo:Vocab.Current}}"/>
                            </Border>
                            <!-- vertical border -->
                            <Border Grid.Row="2" Grid.RowSpan="3" Background="{TemplateBinding MainBorderBrush}"/>
                            <Border Grid.Column="2" Grid.RowSpan="5" Background="{TemplateBinding MainBorderBrush}"/>
                            <Border Grid.Column="4" Grid.RowSpan="5" Background="{TemplateBinding VerticalDashBrush}"/>
                            <Border Grid.Column="6" Grid.RowSpan="5" Background="{TemplateBinding MainBorderBrush}"/>
                            <!-- horizontal border -->
                            <Border Grid.Column="2" Grid.ColumnSpan="5" Background="{TemplateBinding MainBorderBrush}"/>
                            <Border Grid.ColumnSpan="7" Grid.Row="2" Background="{TemplateBinding MainBorderBrush}"/>
                            <Border Grid.ColumnSpan="7" Grid.Row="4" Background="{TemplateBinding MainBorderBrush}"/>
                        </Grid>
                        <Grid Grid.Column="3" Margin="-1,0,0,0" Visibility="{TemplateBinding IsSideDeckVisible, Converter={StaticResource BVConv}}" Grid.IsSharedSizeScope="True">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="1"/>
                                <RowDefinition Height="{TemplateBinding HeaderHeight}"/>
                                <RowDefinition Height="1"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="1"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Label"/>
                                <ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="{TemplateBinding NameWidth4}"/>
                                <ColumnDefinition Width="1"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel x:Name="SideDeck" Grid.Row="3" Grid.Column="3" Grid.ColumnSpan="3"/>
                            <!-- header -->
                            <Border Grid.Column="1" Grid.Row="3" Background="{TemplateBinding Background}">
                                <ct:VerticalTextBlock Text="{Binding Deck_Side.Value, Source={x:Static ygo:Vocab.Current}}"/>
                            </Border>
                            <Border Grid.Column="3" Grid.Row="1" Background="{TemplateBinding Background}">
                                <TextBlock Text="{Binding Deck_Count.Value, Source={x:Static ygo:Vocab.Current}}"/>
                            </Border>
                            <Border Grid.Column="5" Grid.Row="1" Background="{TemplateBinding Background}">
                                <TextBlock Text="{Binding CInfo.Name.Value, Source={x:Static ygo:Vocab.Current}}"/>
                            </Border>
                            <!-- vertical border -->
                            <Border Grid.Row="2" Grid.RowSpan="3" Background="{TemplateBinding MainBorderBrush}"/>
                            <Border Grid.Column="2" Grid.RowSpan="5" Background="{TemplateBinding MainBorderBrush}"/>
                            <Border Grid.Column="4" Grid.RowSpan="5" Background="{TemplateBinding VerticalDashBrush}"/>
                            <Border Grid.Column="6" Grid.RowSpan="5" Background="{TemplateBinding MainBorderBrush}"/>
                            <!-- horizontal border -->
                            <Border Grid.Column="2" Grid.ColumnSpan="5" Background="{TemplateBinding MainBorderBrush}"/>
                            <Border Grid.ColumnSpan="7" Grid.Row="2" Background="{TemplateBinding MainBorderBrush}"/>
                            <Border Grid.ColumnSpan="7" Grid.Row="4" Background="{TemplateBinding MainBorderBrush}"/>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="local:MatchTypeSelector" BasedOn="{StaticResource ComboBoxBase}">
        <Setter Property="ItemsSource" Value="{x:Static local:MatchTypeItem.Items}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="SelectedItem" Value="{Binding MatchType, Mode=TwoWay, RelativeSource={RelativeSource Mode=Self}, Converter={StaticResource CIConv}}"/>
        <Setter Property="ItemTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Text="{Binding Name.Value}"/>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
