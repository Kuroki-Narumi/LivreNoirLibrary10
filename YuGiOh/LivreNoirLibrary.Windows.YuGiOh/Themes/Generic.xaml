    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
    mc:Ignorable="po"
    xmlns:local="clr-namespace:LivreNoirLibrary.Windows.YuGiOh.Controls"
    xmlns:conv="clr-namespace:LivreNoirLibrary.Windows.YuGiOh.Converters"
    xmlns:ygo="clr-namespace:LivreNoirLibrary.Windows.YuGiOh"
    xmlns:ct="clr-namespace:LivreNoirLibrary.Windows.Controls;assembly=LivreNoirLibrary.Windows.Controls"
    xmlns:md="clr-namespace:LivreNoirLibrary.Windows.Media;assembly=LivreNoirLibrary.Windows.Media"
    xmlns:input="clr-namespace:LivreNoirLibrary.Windows.Input;assembly=LivreNoirLibrary.Windows.Core"
    xmlns:data="clr-namespace:LivreNoirLibrary.YuGiOh.Data;assembly=LivreNoirLibrary.YuGiOh.Core"
    xmlns:ym="clr-namespace:LivreNoirLibrary.YuGiOh.Media;assembly=LivreNoirLibrary.YuGiOh.Core"
    >
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/LivreNoirLibrary.Windows.Controls;component/Themes/Generic.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <SolidColorBrush x:Key="Brush_HeaderBackground" po:Freeze="True" Color="#eee"/>

    <conv:TextLengthConveter x:Key="TextLengthConverter"/>
    <conv:LineFeedConverter x:Key="LFConv"/>
    <conv:ComboItemConverter x:Key="CIConv"/>
    <local:ExpanderStateConverter x:Key="ExpConv"/>

    <Style TargetType="Control" x:Key="ControlBase">
        <Setter Property="FontFamily" Value="Meiryo"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
    </Style>

    <Style x:Key="Label_Header" TargetType="Label">
        <Setter Property="Background" Value="{StaticResource Brush_HeaderBackground}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Padding" Value="4,0"/>
        <Setter Property="MinHeight" Value="26"/>
    </Style>
    
    <Style TargetType="TextBlock" x:Key="TextBlock_RightArrow">
        <Setter Property="Text" Value="＞"/>
        <Setter Property="Margin" Value="4,0"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Grid.Column" Value="1"/>
        <Setter Property="Grid.Row" Value="2"/>
    </Style>

    <Style TargetType="TextBox" x:Key="TextBox_CardInfo">
        <Setter Property="Margin" Value="2,2,0,2"/>
        <Setter Property="Padding" Value="2"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Grid.Column" Value="2"/>
    </Style>

    <Style x:Key="TextBox_Scrollable" TargetType="TextBox">
        <Setter Property="Margin" Value="4"/>
        <Setter Property="Padding" Value="2"/>
        <Setter Property="VerticalContentAlignment" Value="Top"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="AcceptsReturn" Value="True"/>
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
    </Style>
    
    <Style x:Key="TextBlock_TextLength" TargetType="TextBlock">
        <Setter Property="Background" Value="{ct:BrushProvider #8fff}"/>
        <Setter Property="VerticalAlignment" Value="Bottom"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="Margin" Value="0,0,1,1"/>
        <Setter Property="Padding" Value="2,0"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>
    
    <Style x:Key="CardInfo_ButtonBase" TargetType="ct:Button">
        <Setter Property="BorderBrush" Value="{x:Null}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
    </Style>
    <Style x:Key="CardInfo_CopyButton" TargetType="ct:Button" BasedOn="{StaticResource CardInfo_ButtonBase}">
        <Setter Property="Background" Value="{StaticResource Brush_HeaderBackground}"/>
        <Setter Property="Icon" Value="{x:Static md:Icons.Copy}"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Grid.Column" Value="1"/>
    </Style>
    <Style x:Key="CardInfo_ListBox" TargetType="ListBox" BasedOn="{StaticResource Alt2ListBoxStyle}">
        <Setter Property="Height" Value="{x:Static local:CardInfoView.DefaultPackListHeight}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="SelectionMode" Value="Single"/>
        <Setter Property="Grid.Row" Value="1"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    </Style>

    <Style x:Key="RefreshButton" TargetType="ct:Button">
        <Setter Property="Icon" Value="{x:Static md:Icons.Update}"/>
        <Setter Property="Content" Value="{Binding Reload.Value, Source={x:Static ygo:Vocab.Current}}"/>
        <Setter Property="Command" Value="ygo:YgoCommands.RefreshItems"/>
    </Style>
    
    <Style x:Key="ButtonBase_Execute" TargetType="ct:Button">
        <Setter Property="Margin" Value="0,0,4,4"/>
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    
    <Style x:Key="Button_ExecSort" TargetType="ct:Button" BasedOn="{StaticResource ButtonBase_Execute}">
        <Setter Property="Icon" Value="{x:Static md:Icons.UpDown}"/>
        <Setter Property="Content" Value="{Binding Apply.Value, Source={x:Static ygo:Vocab.Current}}"/>
        <Setter Property="IsDefault" Value="True"/>
        <Setter Property="Grid.Column" Value="0"/>
    </Style>

    <Style x:Key="Button_ExecSearch" TargetType="ct:Button" BasedOn="{StaticResource ButtonBase_Execute}">
        <Setter Property="Icon" Value="{x:Static md:Icons.ZoomUp}"/>
        <Setter Property="Content" Value="{Binding Apply.Value, Source={x:Static ygo:Vocab.Current}}"/>
        <Setter Property="IsDefault" Value="True"/>
        <Setter Property="Grid.Column" Value="0"/>
    </Style>

    <Style x:Key="Button_ExecDefault" TargetType="ct:Button" BasedOn="{StaticResource ButtonBase_Execute}">
        <Setter Property="Icon" Value="{x:Static md:Icons.Delete_Mono}"/>
        <Setter Property="Content" Value="{Binding DefaultPreset.Value, Source={x:Static ygo:Vocab.Current}}"/>
        <Setter Property="ToolTip" Value="{Binding Desc_DefaultPreset.Value, Source={x:Static ygo:Vocab.Current}}"/>
        <Setter Property="Grid.Column" Value="1"/>
    </Style>

    <Style x:Key="Button_ExecClose" TargetType="ct:Button" BasedOn="{StaticResource ButtonBase_Execute}">
        <Setter Property="Icon" Value="{x:Static md:Icons.Cross_Red}"/>
        <Setter Property="Content" Value="{Binding Close.Value, Source={x:Static ygo:Vocab.Current}}"/>
        <Setter Property="Grid.Column" Value="3"/>
        <Setter Property="IsCancel" Value="True"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>

