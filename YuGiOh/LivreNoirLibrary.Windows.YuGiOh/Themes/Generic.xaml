    <Style x:Key="MenuItem_Paste" TargetType="MenuItem" BasedOn="{StaticResource MenuItemBase_Paste}">
        <Setter Property="Header" Value="{Binding Paste.MenuHeader, Source={x:Static ygo:Vocab.Current}}"/>
