    <Style x:Key="IconButton_ListClear" TargetType="ct:Button" BasedOn="{StaticResource IconButtonBase}">
        <Setter Property="Icon" Value="{x:Static md:Icons.Cross}"/>
        <Setter Property="ToolTip" Value="{Binding Clear.Value, Source={x:Static ygo:Vocab.Current}}"/>
        <Setter Property="Margin" Value="4,0,0,0"/>
    </Style>

