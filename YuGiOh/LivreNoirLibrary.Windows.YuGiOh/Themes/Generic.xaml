    <Style x:Key="MenuItem_Open" TargetType="MenuItem" BasedOn="{StaticResource MenuItemBase_Open}">
        <Setter Property="Header" Value="{Binding Open.MenuHeader, Source={x:Static ygo:Vocab.Current}}"/>
    </Style>
    <Style x:Key="MenuItem_Save" TargetType="MenuItem" BasedOn="{StaticResource MenuItemBase_Save}">
        <Setter Property="Header" Value="{Binding Save.MenuHeader, Source={x:Static ygo:Vocab.Current}}"/>
    </Style>
    <Style x:Key="MenuItem_Overwrite" TargetType="MenuItem" BasedOn="{StaticResource MenuItemBase_New}">
