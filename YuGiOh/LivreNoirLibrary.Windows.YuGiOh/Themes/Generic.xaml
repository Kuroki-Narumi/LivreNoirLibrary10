    <DataTemplate x:Key="ItemTemplate_CardType" DataType="data:ICard">
        <TextBlock Text="{Binding ThisCard.CTypeText}" HorizontalAlignment="Left"/>
    </DataTemplate>
    <DataTemplate x:Key="ItemTemplate_Attribute" DataType="data:ICard">
        <TextBlock Text="{Binding ThisCard.AttrText}" HorizontalAlignment="Center"/>
    </DataTemplate>
    <DataTemplate x:Key="ItemTemplate_MonsterType" DataType="data:ICard">
