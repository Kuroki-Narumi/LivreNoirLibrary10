    <DataTemplate x:Key="GridViewHeader_Attribute">
        <TextBlock Text="{Binding CInfo.Attribute.Value, Source={x:Static ygo:Vocab.Current}}" Tag="Attribute"/>
    </DataTemplate>
    <DataTemplate x:Key="GridViewHeader_MonsterType">
        <TextBlock Text="{Binding CInfo.MonsterType.Value, Source={x:Static ygo:Vocab.Current}}" Tag="MonsterType"/>
    </DataTemplate>
    <DataTemplate x:Key="GridViewHeader_Level">
        <TextBlock Text="{Binding CInfo.LevelSymbol.Value, Source={x:Static ygo:Vocab.Current}}" Tag="Level"/>
