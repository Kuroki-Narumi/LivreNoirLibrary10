    </Style>
    <Style x:Key="IconButton_MoveUp" TargetType="ct:Button" BasedOn="{StaticResource IconButtonBase_MoveUp}">
        <Setter Property="ToolTip" Value="{Binding MoveUp.Value, Source={x:Static ygo:Vocab.Current}}"/>
    </Style>
    <Style x:Key="IconButton_MoveDown" TargetType="ct:Button" BasedOn="{StaticResource IconButtonBase_MoveDown}">
