    <DataTemplate x:Key="ItemTemplate_Tuner" DataType="data:ICard">
        <ct:IconPresenter Height="16" HorizontalAlignment="Center" Source="{Binding ThisCard.TunerIcon}" ToolTip="{Binding Abi.Tuner.Value, Source={x:Static ygo:Vocab.Current}}"/>
