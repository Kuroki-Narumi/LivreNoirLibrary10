<Window x:Class="LivreNoirLibrary.Sandbox.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LivreNoirLibrary.Sandbox"
        xmlns:ctrl="clr-namespace:LivreNoirLibrary.Windows.Controls;assembly=LivreNoirLibrary.Wpf"
        xmlns:win="clr-namespace:LivreNoirLibrary.Windows;assembly=LivreNoirLibrary.Wpf"
        xmlns:media="clr-namespace:LivreNoirLibrary.Media;assembly=LivreNoirLibrary.Wpf"
        mc:Ignorable="d" FontSize="14" UseLayoutRounding="True"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <TabControl ItemContainerStyle="{StaticResource TabItem_Cornered}">
            <TabItem Header="ImageRectSelector">
                <Grid AllowDrop="True" DragOver="OnDragOver_Image" Drop="OnDrop_Image">
                    <ctrl:ImageRectSelector x:Name="ImageRectSelector" Grid.Row="1"/>
                </Grid>
            </TabItem>
            <TabItem Header="Color">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <ctrl:ColorPicker x:Name="ColorPicker" Modified="OnModified_Color"/>
                        <CheckBox Content="Alpha" IsChecked="{Binding IsAlphaEnabled, ElementName=ColorPicker, Mode=TwoWay}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Rectangle Grid.Row="1" Fill="{x:Static media:MediaUtils.TransparentCheckerBrush}"/>
                    <Rectangle Grid.Row="1">
                        <Rectangle.Fill>
                            <SolidColorBrush Color="{Binding SelectedColor, ElementName=ColorPicker}"/>
                        </Rectangle.Fill>
                    </Rectangle>
                </Grid>
            </TabItem>
            <TabItem Header="Coprime">
                <WrapPanel Orientation="Horizontal">
                    <ctrl:IntTextBox x:Name="TextBox_Coprime" Minimum="1" Width="64" VerticalContentAlignment="Center" HorizontalContentAlignment="Right"/>
                    <ctrl:Button Grid.Column="1" Content="計算" Click="OnClick_Coprime"/>
                    <Border BorderBrush="Black" BorderThickness="1" Padding="4,0">
                        <TextBlock Text="0123456789&#x0A;ABCDEFGHIJ&#x0A;KLMNOPQRST&#x0A;UVWXYZabcd&#x0A;efghijklmn&#x0A;opqrstuvwx&#x0A;yz.:/()+-*^%&#x0A;!?#" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Consolas" FontSize="11" LineHeight="9" LineStackingStrategy="BlockLineHeight"/>
                    </Border>
                    <Image Source="Resources/IndexLetters.png" Stretch="None"/>
                </WrapPanel>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
