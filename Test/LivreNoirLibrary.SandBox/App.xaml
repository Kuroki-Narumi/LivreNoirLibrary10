<Application x:Class="LivreNoirLibrary.SandBox.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LivreNoirLibrary.SandBox"
             xmlns:ct="clr-namespace:LivreNoirLibrary.Windows.Controls;assembly=LivreNoirLibrary.Windows.Controls"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/LivreNoirLibrary.Windows.Controls;component/Themes/Generic.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            
            <Style TargetType="ct:Button">
                <Setter Property="Margin" Value="4"/>
            </Style>

            <Style TargetType="TabControl">
                <EventSetter Event="MouseWheel" Handler="TabControl_PreviewMouseWheel"/>
            </Style>

            <Style x:Key="LabeledSliderStyle" TargetType="ct:LabeledSlider">
                <Setter Property="Margin" Value="4"/>
                <Setter Property="SliderWidth" Value="160"/>
                <Setter Property="IsTextEditable" Value="True"/>
                <Setter Property="Minimum" Value="256"/>
                <Setter Property="Maximum" Value="1920"/>
                <Setter Property="IsSnapToTickEnabled" Value="True"/>
                <Setter Property="TickFrequency" Value="16"/>
                <EventSetter Event="PreviewMouseWheel" Handler="LabeledSlider_PreviewMouseWheel"/>
            </Style>

            <Style TargetType="ComboBox" BasedOn="{StaticResource ComboBoxBase}">
                <Setter Property="Margin" Value="4"/>
                <Setter Property="AlternationCount" Value="2"/>
                <Setter Property="ItemContainerStyle" Value="{StaticResource Alt2ListBoxItemContainerStyle}"/>
                <EventSetter Event="PreviewMouseWheel" Handler="ComboBox_PreviewMouseWheel"/>
            </Style>
            
            <Style x:Key="MenuButton" TargetType="ct:Button">
                <Setter Property="Margin" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="CornerRadius" Value="0"/>
            </Style>

            <Style x:Key="MenuToggleButton" TargetType="ct:ToggleButton">
                <Setter Property="Margin" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="CornerRadius" Value="0"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="IsOptionMarkVisible" Value="False"/>
            </Style>

            <Style x:Key="MenuRadioButton" TargetType="ct:RadioButton">
                <Setter Property="Margin" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="CornerRadius" Value="0"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="IsOptionMarkVisible" Value="False"/>
            </Style>

            <Style x:Key="RadioContainerBase" TargetType="Panel">
                <Setter Property="Background" Value="Transparent"/>
                <EventSetter Event="PreviewMouseWheel" Handler="RadioContainer_MouseWheel"/>
            </Style>

            <Style TargetType="Border" x:Key="Separator">
                <Setter Property="Width" Value="1"/>
                <Setter Property="Margin" Value="2,4"/>
                <Setter Property="Background" Value="Gray"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
