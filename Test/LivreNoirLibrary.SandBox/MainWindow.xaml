<Window x:Class="LivreNoirLibrary.SandBox.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LivreNoirLibrary.SandBox"
        xmlns:ct="clr-namespace:LivreNoirLibrary.Windows.Controls;assembly=LivreNoirLibrary.Windows.Controls"
        xmlns:ctBms="clr-namespace:LivreNoirLibrary.Windows.Controls.Bms;assembly=LivreNoirLibrary.Windows.Media.Integrated"
        xmlns:skinInfo="clr-namespace:LivreNoirLibrary.Windows.Media.Bms.SkinInfo;assembly=LivreNoirLibrary.Windows.Media.Integrated"
        xmlns:media="clr-namespace:LivreNoirLibrary.Windows.Media;assembly=LivreNoirLibrary.Windows.Media"
        xmlns:conv="clr-namespace:LivreNoirLibrary.Windows.Converters;assembly=LivreNoirLibrary.Windows.Controls"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=local:MainWindow}"
        Title="MainWindow" Height="540" Width="880" FontSize="14">
    <Window.Resources>
        <Style TargetType="ct:Button">
            <Setter Property="Margin" Value="4"/>
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource ComboBoxBase}">
            <Setter Property="Margin" Value="4"/>
            <Setter Property="AlternationCount" Value="2"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource Alt2ListBoxItemContainerStyle}"/>
            <EventSetter Event="PreviewMouseWheel" Handler="ComboBox_PreviewMouseWheel"/>
        </Style>
    </Window.Resources>
    <TabControl MouseWheel="TabControl_PreviewMouseWheel">
        <TabItem Header="BMS">
            <Grid AllowDrop="True" DragOver="OnDragOver_Bms" Drop="OnDrop_Bms">
                <Grid x:Name="MainUI" RowDefinitions="Auto, *">
                    <Grid.Resources>
                        <Style TargetType="ct:LabeledSlider">
                            <Setter Property="Margin" Value="4"/>
                            <Setter Property="SliderWidth" Value="160"/>
                            <Setter Property="IsTextEditable" Value="True"/>
                            <Setter Property="Minimum" Value="256"/>
                            <Setter Property="Maximum" Value="1920"/>
                            <Setter Property="IsSnapToTickEnabled" Value="True"/>
                            <Setter Property="TickFrequency" Value="16"/>
                            <EventSetter Event="PreviewMouseWheel" Handler="LabeledSlider_PreviewMouseWheel"/>
                        </Style>
                        <Style TargetType="ct:Button">
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="CornerRadius" Value="0"/>
                        </Style>
                    </Grid.Resources>
                    <WrapPanel Orientation="Horizontal" UseLayoutRounding="True">
                        <WrapPanel.Resources>
                            <Style TargetType="Border" x:Key="Separator">
                                <Setter Property="Width" Value="1"/>
                                <Setter Property="Margin" Value="2,4"/>
                                <Setter Property="Background" Value="Gray"/>
                            </Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Margin" Value="4,0,2,0"/>
                            </Style>
                            <Style x:Key="Header" TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Margin" Value="2,0"/>
                            </Style>
                            <Style x:Key="Top" TargetType="TextBlock">
                                <Setter Property="Grid.ColumnSpan" Value="2"/>
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Margin" Value="4,2"/>
                            </Style>
                            <conv:DoubleLinearConverter x:Key="PercentConv" Slope="100" Rounding="Round"/>
                            <conv:DoubleLinearConverter x:Key="MsConv" Slope="1000" Rounding="Round"/>
                            <Style x:Key="SliderBase" TargetType="ct:LabeledSlider">
                                <Setter Property="Grid.Column" Value="1"/>
                                <Setter Property="Margin" Value="0,2,4,2"/>
                                <Setter Property="MinWidth" Value="100"/>
                                <Setter Property="TextWidth" Value="36"/>
                                <Setter Property="IsSnapToTickEnabled" Value="True"/>
                                <Setter Property="IsTextEditable" Value="True"/>
                            </Style>
                            <Style x:Key="HsSlider" TargetType="ct:LabeledSlider" BasedOn="{StaticResource SliderBase}">
                                <Setter Property="Minimum" Value="10"/>
                                <Setter Property="Maximum" Value="990"/>
                                <Setter Property="TickFrequency" Value="10"/>
                                <Setter Property="SmallChange" Value="10"/>
                                <Setter Property="LargeChange" Value="50"/>
                            </Style>
                            <Style x:Key="VolumeSlider" TargetType="ct:LabeledSlider" BasedOn="{StaticResource SliderBase}">
                                <Setter Property="Minimum" Value="0"/>
                                <Setter Property="Maximum" Value="100"/>
                                <Setter Property="TickFrequency" Value="5"/>
                                <Setter Property="SmallChange" Value="5"/>
                                <Setter Property="LargeChange" Value="10"/>
                            </Style>
                            <Style x:Key="KbpsSlider" TargetType="ct:LabeledSlider">
                                <Setter Property="Margin" Value="4,2,0,2"/>
                                <Setter Property="Minimum" Value="1000"/>
                                <Setter Property="Maximum" Value="50000"/>
                                <Setter Property="TickFrequency" Value="500"/>
                                <Setter Property="SmallChange" Value="100"/>
                                <Setter Property="LargeChange" Value="1000"/>
                                <Setter Property="TextWidth" Value="48"/>
                                <Setter Property="IsSnapToTickEnabled" Value="True"/>
                                <Setter Property="IsTextEditable" Value="True"/>
                            </Style>
                            <Style x:Key="MsSlider" TargetType="ct:LabeledSlider" BasedOn="{StaticResource SliderBase}">
                                <Setter Property="Minimum" Value="-100"/>
                                <Setter Property="Maximum" Value="100"/>
                                <Setter Property="TickFrequency" Value="1"/>
                                <Setter Property="SmallChange" Value="1"/>
                                <Setter Property="LargeChange" Value="10"/>
                            </Style>
                        </WrapPanel.Resources>
                        <TextBlock Text="Skin"/>
                        <ComboBox x:Name="ComboBox_Skin" SelectedItem="{Binding BmsScreen.Skin, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate DataType="skinInfo:PlaySkin">
                                    <TextBlock Text="{Binding Name}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <ct:Button Icon="{x:Static ct:Icons.Config}" ToolTip="Skin Optins" Click="OnClick_SkinOptions" IsEnabled="{Binding BmsScreen.HasSkinOptions}"/>

                        <Border Style="{StaticResource Separator}"/>
                        <ct:Button Icon="{x:Static ct:Icons.Open}" Content="{Binding BmsScreen.BmsBaseName}" ToolTip="Open" Command="ApplicationCommands.Open"/>
                        <ct:Button Icon="{x:Static ct:Icons.Save}" ToolTip="Save" Command="ApplicationCommands.Save"/>

                        <Border Style="{StaticResource Separator}"/>
                        <ct:DropDownMenuButton>
                            <ct:IconPresenter Width="16" Source="{x:Static ct:Icons.Volume_3}"/>
                            <ct:DropDownMenuButton.DropDownContent>
                                <Grid ColumnDefinitions="Auto, *" RowDefinitions="Auto, Auto, Auto, Auto, Auto">
                                    <TextBlock Style="{StaticResource Top}" Text="Volume"/>
                                    <TextBlock Grid.Row="1" Style="{StaticResource Header}" Text="Master"/>
                                    <TextBlock Grid.Row="2" Style="{StaticResource Header}" Text="Key"/>
                                    <TextBlock Grid.Row="3" Style="{StaticResource Header}" Text="Bgm"/>
                                    <ct:LabeledSlider Grid.Row="1" Style="{StaticResource VolumeSlider}" Value="{Binding BmsOptions.MasterVolume, Converter={StaticResource PercentConv}}"/>
                                    <ct:LabeledSlider Grid.Row="2" Style="{StaticResource VolumeSlider}" Value="{Binding BmsOptions.KeyVolume, Converter={StaticResource PercentConv}}"/>
                                    <ct:LabeledSlider Grid.Row="3" Style="{StaticResource VolumeSlider}" Value="{Binding BmsOptions.BgmVolume, Converter={StaticResource PercentConv}}"/>
                                    <TextBlock Grid.Row="4" Style="{StaticResource Header}" Text="S.Rate" />
                                    <ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{x:Static local:MainWindow.SampleRateList}" SelectedItem="{Binding BmsOptions.AudioSampleRate}"/>
                                </Grid>
                            </ct:DropDownMenuButton.DropDownContent>
                        </ct:DropDownMenuButton>
                        <ct:DropDownMenuButton>
                            <ct:IconPresenter Width="16" Source="{x:Static ct:Icons.Download}"/>
                            <ct:DropDownMenuButton.DropDownContent>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Top}" Text="HighSpeed"/>
                                    <ct:LabeledSlider Style="{StaticResource HsSlider}" Value="{Binding BmsOptions.HighSpeed, Converter={StaticResource PercentConv}}"/>
                                    <Grid ColumnDefinitions="Auto, *">
                                        <TextBlock Style="{StaticResource Header}" Text="Fix"/>
                                        <ComboBox Grid.Column="1" ItemsSource="{x:Static local:MainWindow.HsCorrectionModes}" SelectedItem="{Binding BmsOptions.HsCorrectionMode}"/>
                                    </Grid>
                                </StackPanel>
                            </ct:DropDownMenuButton.DropDownContent>
                        </ct:DropDownMenuButton>

                        <Border Style="{StaticResource Separator}"/>
                        <ct:Button Icon="{x:Static ct:Icons.Wave}" ToolTip="Assemble" Click="OnClick_Assemble" IsEnabled="{Binding BmsScreen.IsBmsReady, Mode=OneWay}"/>

                        <Border Style="{StaticResource Separator}"/>

                        <ct:DropDownMenuButton>
                            <ct:IconPresenter Source="{x:Static ct:Icons.Config}" Width="16"/>
                            <ct:DropDownMenuButton.DropDownContent>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Top}" Text="Video"/>
                                    <StackPanel Orientation="Horizontal">
                                        <ComboBox ItemsSource="{x:Static local:MainWindow.FpsList}" SelectedItem="{Binding BmsOptions.FrameRate}"/>
                                        <TextBlock Margin="0,2,4,2" Text="FPS"/>
                                        <StackPanel Background="Transparent" PreviewMouseWheel="RadioContainer_MouseWheel" Orientation="Horizontal" Margin="4,0">
                                            <StackPanel.Resources>
                                                <Style TargetType="RadioButton">
                                                    <Setter Property="Margin" Value="2,0"/>
                                                    <Setter Property="GroupName" Value="IsHevc"/>
                                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                                </Style>
                                            </StackPanel.Resources>
                                            <RadioButton Content="H264" IsChecked="{Binding BmsOptions.IsHevc, Converter={StaticResource InvertConverter}}"/>
                                            <RadioButton Content="HEVC" IsChecked="{Binding BmsOptions.IsHevc}"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Grid ColumnDefinitions="*, Auto">
                                        <ct:LabeledSlider Style="{StaticResource KbpsSlider}" Value="{Binding BmsOptions.ApproximateKbps}"/>
                                        <TextBlock Grid.Column="1" Margin="4,2,4,2" Text="Kbps"/>
                                    </Grid>
                                    <Grid ColumnDefinitions="*, Auto">
                                        <ct:LabeledSlider Grid.Column="0" Header="Start" Style="{StaticResource MsSlider}" Minimum="0" Maximum="120000" Value="{Binding BmsOptions.StartOffset, Converter={StaticResource MsConv}}"/>
                                        <TextBlock Grid.Column="1" Margin="4,2,4,2" Text="ms"/>
                                    </Grid>
                                    <Grid ColumnDefinitions="*, Auto">
                                        <ct:LabeledSlider Grid.Column="0" Header="Audio Delay" Style="{StaticResource MsSlider}" Value="{Binding BmsOptions.AudioDelay, Converter={StaticResource MsConv}}"/>
                                        <TextBlock Grid.Column="1" Margin="4,2,4,2" Text="ms"/>
                                    </Grid>
                                </StackPanel>
                            </ct:DropDownMenuButton.DropDownContent>
                        </ct:DropDownMenuButton>
                        <ct:Button Icon="{x:Static ct:Icons.Camera}" ToolTip="Save Video" Click="OnClick_Video" IsEnabled="{Binding BmsScreen.IsBmsReady, Mode=OneWay}"/>
                        <ct:Button Icon="{x:Static ct:Icons.Play}" ToolTip="Play" Click="OnClick_Play" IsEnabled="{Binding BmsScreen.IsBmsReady, Mode=OneWay}"/>
                        
                        <Border Style="{StaticResource Separator}"/>
                        <ct:Button Content="TestOut" Click="OnClick_TestOut"/>
                    </WrapPanel>
                    <Rectangle Grid.Row="1">
                        <Rectangle.Fill>
                            <VisualBrush Visual="{Binding BmsScreen}" Stretch="Uniform"/>
                        </Rectangle.Fill>
                    </Rectangle>
                    <Border Grid.Row="1" Background="{ct:BrushProvider 8000}" HorizontalAlignment="Left" VerticalAlignment="Top" Padding="2">
                        <TextBlock Text="{Binding BmsScreen.DebugText}" Foreground="White" FontSize="12" FontFamily="Consolas"/>
                    </Border>
                    <ct:CenteringPanel Grid.RowSpan="2">
                        <ctBms:SkinOptionView x:Name="SkinOptionView"/>
                    </ct:CenteringPanel>
                </Grid>
                <ct:TaskProgressBar x:Name="TaskProgressBar"/>
            </Grid>
        </TabItem>
        <TabItem Header="Picture">
            <Grid Margin="4" ColumnDefinitions="*, 4, *, 4, *">
                <Grid.Resources>
                    <Style TargetType="TextBlock">
                    </Style>
                    <Style TargetType="Grid" x:Key="MainGrid">
                        <Setter Property="Grid.Row" Value="1"/>
                        <Setter Property="Background" Value="Gray"/>
                        <Setter Property="AllowDrop" Value="True"/>
                        <EventSetter Event="DragOver" Handler="OnDragOver_Image"/>
                        <EventSetter Event="Drop" Handler="OnDrop_Image"/>
                    </Style>
                    <Style TargetType="Rectangle">
                        <Setter Property="Fill" Value="{x:Static media:MediaUtils.TransparentCheckerBrush}"/>
                    </Style>
                </Grid.Resources>
                <Grid Grid.Column="0" RowDefinitions="Auto, *">
                    <TextBlock Text="Source"/>
                    <Grid Style="{StaticResource MainGrid}">
                        <Rectangle Width="{Binding ActualWidth, ElementName=Image_Source}" Height="{Binding ActualHeight, ElementName=Image_Source}"/>
                        <ct:ImageRectSelectorView x:Name="Image_Source"/>
                    </Grid>
                </Grid>
                <Grid Grid.Column="2" RowDefinitions="Auto, *">
                    <TextBlock Text="Target" />
                    <Grid Style="{StaticResource MainGrid}">
                        <Rectangle Width="{Binding ActualWidth, ElementName=Image_Target}" Height="{Binding ActualHeight, ElementName=Image_Target}"/>
                        <ct:ImageRectSelectorView x:Name="Image_Target"/>
                    </Grid>
                </Grid>
                <Grid Grid.Column="4" RowDefinitions="Auto, *">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Result" VerticalAlignment="Bottom"/>
                        <ComboBox Name="ComboBox_BlendMode" ItemsSource="{x:Static local:MainWindow.BlendModes}" SelectedIndex="0"/>
                        <ct:LabeledSlider x:Name="Slider_Opacity" SliderWidth="50" Minimum="0" Maximum="100" Value="100" TickFrequency="5" IsSnapToTickEnabled="True"/>
                        <ct:Button Icon="{x:Static ct:Icons.Check_Green}" Click="OnClick_Image_Blend"/>
                        <ct:Button Icon="{x:Static ct:Icons.Save}" Click="OnClick_Image_Save"/>
                    </StackPanel>
                    <Grid Style="{StaticResource MainGrid}" AllowDrop="False">
                        <Rectangle Width="{Binding ActualWidth, ElementName=Image_Result}" Height="{Binding ActualHeight, ElementName=Image_Result}"/>
                        <Image x:Name="Image_Result"/>
                    </Grid>
                </Grid>
            </Grid>
        </TabItem>
    </TabControl>
</Window>
