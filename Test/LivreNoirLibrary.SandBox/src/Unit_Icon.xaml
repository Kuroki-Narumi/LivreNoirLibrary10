<UserControl x:Class="LivreNoirLibrary.SandBox.Unit_Icon"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:LivreNoirLibrary.SandBox"
             xmlns:ct="clr-namespace:LivreNoirLibrary.Windows.Controls;assembly=LivreNoirLibrary.Windows.Controls"
             xmlns:media="clr-namespace:LivreNoirLibrary.Windows.Media;assembly=LivreNoirLibrary.Windows.Media"
             xmlns:conv="clr-namespace:LivreNoirLibrary.Windows.Converters;assembly=LivreNoirLibrary.Windows.Controls"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=local:Unit_Icon}"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid RowDefinitions="Auto, *">
        <WrapPanel Orientation="Horizontal">
            <ComboBox x:Name="ComboBox_IconList" Width="224" VerticalAlignment="Center" ItemsSource="{x:Static ct:Icons.IconList}" Style="{StaticResource ComboBoxBase}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <ct:IconPresenter Source="{Binding Drawing}" VerticalAlignment="Center" Height="16"/>
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Margin="2,0,0,0"/>
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <ct:Button Icon="{x:Static ct:Icons.Save}" Click="OnClick_Save"/>
        </WrapPanel>
        <ct:ColorPalette Grid.Row="1" x:Name="ColorPalette"/>
        <ct:IconPresenter Grid.Row="1" Source="{Binding ElementName=ColorPalette}" Stretch="UniformToFill" FontFamily="Meiryo"/>
    </Grid>
</UserControl>
