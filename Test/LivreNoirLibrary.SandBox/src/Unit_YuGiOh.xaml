<UserControl x:Class="LivreNoirLibrary.SandBox.Unit_YuGiOh"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:LivreNoirLibrary.SandBox"
             xmlns:ct="clr-namespace:LivreNoirLibrary.Windows.Controls;assembly=LivreNoirLibrary.Windows.Controls"
             xmlns:ygo="clr-namespace:LivreNoirLibrary.YuGiOh.Data;assembly=LivreNoirLibrary.YuGiOh.Core"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid x:Name="MainUI" RowDefinitions="Auto, *">
            <WrapPanel Orientation="Horizontal">
                <TextBox x:Name="SearchInput" Width="240"/>
                <Button Content="Search" Click="OnClick_Search"/>
                <Button Content="Update" Click="OnClick_Test"/>
            </WrapPanel>
            <Grid ColumnDefinitions="*, 3*" Grid.Row="1">
                <ListView x:Name="ListView_Cards" ItemsSource="{Binding Cards, Source={x:Static ygo:CardPool.Instance}}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>
        <ct:TaskProgressBar x:Name="TaskProgressBar"/>
    </Grid>
</UserControl>
