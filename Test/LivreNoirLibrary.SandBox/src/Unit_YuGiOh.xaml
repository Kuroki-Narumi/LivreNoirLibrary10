<UserControl x:Class="LivreNoirLibrary.SandBox.Unit_YuGiOh"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:LivreNoirLibrary.SandBox"
             xmlns:ct="clr-namespace:LivreNoirLibrary.Windows.Controls;assembly=LivreNoirLibrary.Windows.Controls"
             xmlns:conv="clr-namespace:LivreNoirLibrary.Windows.Converters;assembly=LivreNoirLibrary.Windows.Controls"
             xmlns:ygo="clr-namespace:LivreNoirLibrary.YuGiOh.Data;assembly=LivreNoirLibrary.YuGiOh.Core"
             xmlns:yc="clr-namespace:LivreNoirLibrary.Windows.YuGiOh.Controls;assembly=LivreNoirLibrary.Windows.YuGiOh"
             mc:Ignorable="d" Background="White" FontFamily="Meiryo"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/LivreNoirLibrary.Windows.YuGiOh;component/Themes/Generic.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid x:Name="MainUI" RowDefinitions="Auto, *">
            <WrapPanel Orientation="Horizontal">
                <yc:SearchBar x:Name="SearchBar" Width="300" RequestSearch="OnRequestSearch" RequestOpenSort="OnRequestOpenSort" RequestOpenSearch="OnRequestOpenSearch" RequestClear="OnRequestClear" ItemsCount="{Binding Items.Count, ElementName=ListView_Cards}"/>
                <Button Content="Update Database" Click="OnClick_Test"/>
                <Button Content="Update Regulation" Click="OnClick_Regulation"/>
            </WrapPanel>
            <Grid ColumnDefinitions="*, 3*" Grid.Row="1">
                <Grid.Resources>
                    <conv:LnIconConverter x:Key="IconConv"/>
                </Grid.Resources>
                <ListView x:Name="ListView_Cards" Style="{StaticResource Alt2ListBoxStyle}" ItemsSource="{Binding Cards, Source={x:Static ygo:CardPool.Instance}}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <ct:IconPresenter Height="16" Source="{Binding Icon}" Margin="0,0,4,0"/>
                                <TextBlock Text="{Binding Name}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <yc:CardInfoView Grid.Column="1" Margin="2" Source="{Binding SelectedItem, ElementName=ListView_Cards}"
                                 yc:HyperLinks.CardLinkClicked="CardInfoView_CardLinkClicked"
                                 yc:HyperLinks.PackLinkClicked="CardInfoView_PackLinkClicked"
                                 yc:HyperLinks.RelatedTextClicked="OnRequestSearch"
                                 Detach="CardInfoView_Detach"/>
            </Grid>
        </Grid>
        <ct:TaskProgressBar x:Name="TaskProgressBar"/>
    </Grid>
</UserControl>
