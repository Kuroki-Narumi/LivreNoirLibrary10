<UserControl x:Class="LivreNoirLibrary.SandBox.Unit_Video"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:LivreNoirLibrary.SandBox"
             xmlns:ct="clr-namespace:LivreNoirLibrary.Windows.Controls;assembly=LivreNoirLibrary.Windows.Controls"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=local:Unit_Video}"
             d:DesignHeight="450" d:DesignWidth="800"
             AllowDrop="True">
    <Grid>
        <Grid x:Name="MainUI" RowDefinitions="Auto, *">
            <Grid.Resources>
                <Style TargetType="ct:LabeledSlider" BasedOn="{StaticResource LabeledSliderStyle}"/>
                <Style TargetType="ct:Button" BasedOn="{StaticResource MenuButton}"/>
                <Style TargetType="Border" x:Key="Separator">
                    <Setter Property="Width" Value="1"/>
                    <Setter Property="Margin" Value="2,4"/>
                    <Setter Property="Background" Value="Gray"/>
                </Style>
            </Grid.Resources>
            <Grid ColumnDefinitions="Auto, *, Auto, Auto">
                <WrapPanel Orientation="Horizontal">
                    <ct:Button Icon="{x:Static ct:Icons.Open}" Content="{Binding Player.FileName}" ToolTip="Open" Command="ApplicationCommands.Open"/>
                    <ct:Button Icon="{x:Static ct:Icons.Save}" ToolTip="Save" Command="ApplicationCommands.Save"/>
                    <Border Style="{StaticResource Separator}"/>
                    <ct:Button Icon="{x:Static ct:Icons.Play}" ToolTip="Play" Click="OnClick_Play" IsEnabled="{Binding Player.IsPlayable, Mode=OneWay}"/>
                </WrapPanel>

                <Slider x:Name="VideoSeekbar" Grid.Column="1" Margin="4,0,0,0" VerticalAlignment="Center" PreviewMouseWheel="OnMouseWheel_VideoSeekbar"
                                TickFrequency="1" IsSnapToTickEnabled="True"
                                SmallChange="1" LargeChange="10"
                                Value="{Binding Player.Position, Mode=TwoWay}"
                                Maximum="{Binding Player.Duration, Mode=OneWay}"/>
                <TextBlock Grid.Column="2" Margin="0,0,4,0" VerticalAlignment="Center">
                            <Run Text="{Binding Player.PositionTime, Mode=OneWay, StringFormat={}{0:hh\\:mm\\:ss\\.ff}}"/>
                            <Run Text="/"/>
                            <Run Text="{Binding Player.DurationTime, Mode=OneWay, StringFormat={}{0:hh\\:mm\\:ss\\.ff}}"/>
                </TextBlock>
            </Grid>
            <Rectangle Grid.Row="1">
                <Rectangle.Fill>
                    <VisualBrush Visual="{Binding Player}" Stretch="Uniform"/>
                </Rectangle.Fill>
            </Rectangle>
        </Grid>
        <ct:TaskProgressBar x:Name="TaskProgressBar"/>
    </Grid>
</UserControl>
