<Window x:Class="LivreNoirLibrary.Benchmark.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LivreNoirLibrary.Benchmark"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=local:MainWindowViewModel}"
        Title="MainWindow" Height="400" Width="400">
    <Grid>
        <WrapPanel Orientation="Horizontal" Visibility="Collapsed">
            <Button Content="Color" Click="OnClick_Color"/>
        </WrapPanel>
        <Grid RowDefinitions="Auto, *">
            <Grid ColumnDefinitions="Auto, 128, 24, 36, 48" RowDefinitions="Auto, Auto">
                <Label Content="Value" Grid.Row="0"/>
                <Label Content="Delta" Grid.Row="1"/>
                <TextBox Text="{Binding FloatValue}" Grid.Column="1" Grid.Row="0"/>
                <TextBox Text="{Binding FloatDelta}" Grid.Column="1" Grid.Row="1"/>
                <Button Content="+" Grid.Column="2" Grid.Row="0" Click="OnClick_Float_Plus"/>
                <Button Content="-" Grid.Column="2" Grid.Row="1" Click="OnClick_Float_Minus"/>
                <Button Content="100+" Grid.Column="3" Grid.Row="0" Click="OnClick_Float_Plus100"/>
                <Button Content="100-" Grid.Column="3" Grid.Row="1" Click="OnClick_Float_Minus100"/>
                <Button Content="10000+" Grid.Column="4" Grid.Row="0" Click="OnClick_Float_Plus10000"/>
                <Button Content="10000-" Grid.Column="4" Grid.Row="1" Click="OnClick_Float_Minus10000"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
