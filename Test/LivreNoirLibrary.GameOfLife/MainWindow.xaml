<Window x:Class="LivreNoirLibrary.GameOfLife.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LivreNoirLibrary.GameOfLife"
        xmlns:ct="clr-namespace:LivreNoirLibrary.Windows.Controls;assembly=LivreNoirLibrary.Windows.Controls"
        xmlns:md="clr-namespace:LivreNoirLibrary.Windows.Media;assembly=LivreNoirLibrary.Windows.Media"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <DockPanel>
        <WrapPanel DockPanel.Dock="Top">
            <WrapPanel.Resources>
                <Style TargetType="ct:Button">
                    <Setter Property="Margin" Value="2"/>
                </Style>
            </WrapPanel.Resources>
            <ct:Button Icon="{x:Static md:Icons.Play}" Content="Start" Click="OnClick_Start"/>
            <ct:Button Icon="{x:Static md:Icons.Stop}" Content="Stop" Click="OnClick_Stop"/>
            <ct:Button Icon="{x:Static md:Icons.Cross_Red}" Content="Clear" Click="OnClick_Clear"/>
        </WrapPanel>
        <Image x:Name="MainImage" DockPanel.Dock="Bottom" Stretch="None" MouseDown="OnMouseDown_MainImage"/>
    </DockPanel>
</Window>
